# Exact polynomial data for the transparent Z_17 Haagerup-Izumi Q-system
# All three B orbit polynomials are now certified against a complete exact
# HI matrix by hi_stark_seedless.gp; see Section 29 of the research notes.
# Convention: delta satisfies delta^2 - 17*delta - 1 = 0, delta > 0.
# Core entries are A[g,h].  Put B[g,h] = (delta-1)*A[g,h].
#
# Generic ratio classes in F_17:
#   O2 = {2,9,16}
#   O3 = {3,6,8,10,12,15}
#   O4 = {4,5,7,11,13,14}
#
# If g,h are nonzero and g != h, t = h/g mod 17 determines the type.
#
# This file contains:
# 1) clean degree-16 polynomials P_t for B over Q(delta);
# 2) primitive degree-32 polynomials M_t for the actual A entries over Q.

Qy.<y> = PolynomialRing(QQ)
K.<delta> = NumberField(y^2 - 17*y - 1, embedding=17.0586213843)
R.<z> = PolynomialRing(K)
S.<x> = PolynomialRing(QQ)

Kcoeff = {2: [(1, 0), (-1, 0), (-2580, 150), (7856, -462), (1421008, -83294), (-4237905, 248395), (-107944297, 6328294), (-140236552, 8221011), (643252625, -37715514), (8221011, -479365), (-363299, 152211), (-9835, -182385), (36902, 629210), (-124086, -2116736), (-1789620, -30528450), (-1439560, -24556909), (24556909, 418907013)], 3: [(1, 0), (88, -4), (2770, -151), (34942, -1980), (71997, -3962), (-1721469, 101419), (-7809793, 457226), (23941037, -1412808), (86056376, -5091529), (-1412808, -76699), (-36951, -170941), (146537, 2493783), (1279116, 21819941), (5767854, 98391638), (16383970, 279487941), (28453644, 485379940), (24556909, 418907013)], 4: [(1, 0), (54, -4), (337, -13), (-19861, 1126), (-378462, 22347), (-2225467, 130012), (-1210231, 71385), (27441545, -1605286), (62238779, -3670344), (-1605286, 151683), (3314, 127723), (-129459, -2216066), (796629, 13589469), (-3230353, -55105369), (9724813, 165891903), (-20491396, -349554966), (24556909, 418907013)]}

def poly_from_ab(coeff):
    # coeff is descending
    n = len(coeff)-1
    return sum((K(a)+K(b)*delta)*z^(n-i) for i,(a,b) in enumerate(coeff))

P2 = poly_from_ab(Kcoeff[2])
P3 = poly_from_ab(Kcoeff[3])
P4 = poly_from_ab(Kcoeff[4])

M2_coeff = [48661191875666868481, 42936345772647236895, -112415266990638758034773, -316342278174670590219252, 55276081138858374394747154, 152226628126561634880327253, -3759031962437210052959557858, 4815735495405926594146945832, 19933591812610693530379474794, -1835371633001572598052126898, -1667865696790557370319129962, -89161293602456176058080785, 36003617638448350064115918, -10102013485812402132430532, 9179238190901995877855699, -45176198169434267932565, -560872934409947973208161, 28425414574230562578361, 38204994243351922778563, -3673934964792562212456, 740612131245733326648, -190180089154167144303, -138684799695898202254, -3453537895310317010, 7454183327688709544, -84447240520339578, -3751782494532518, -8310633189093, 151615956962, 47219852, -844243, -19, 1]
M3_coeff = [48661191875666868481, -3995942579907702847028, 115705538099436011588362, -1292492522313610347985272, 1118354222301383187514122, 65618787008299885767048527, -191408416780047373688508025, -1069771743394933986101419936, 1512360644115071769427708585, 2657309273954296422121575548, 1817091998405722748197734500, 725770952998488366943167625, 181485459401094653894960319, 24568182648550463617684523, -796700082018077048590693, -1422162093235882349373641, -473252083612124266338065, -107567207165900463302441, -10481550839605001277183, 5044156818447592576335, 3184713615460646765143, 949110333517527221937, 176266021912705840534, 20198724538037472762, 1206711052523803525, 9426706234052668, -331994743962341, -3138225607807, 11680687026, 223599828, 936042, 1612, 1]
M4_coeff = [48661191875666868481, -2536106823637696792598, 16897556784368680229795, 803218391645789007992790, -15431964319550744922609432, 95136525850882864805844338, -121136556028463899299587201, -823183337563992106190368071, 2691576646770532020007287788, -2052569645719915944226222720, 958649335131516352963239256, -319511868773768988768287371, 78563745818819251161085769, -12239534440796340833604858, 319539780032983379602605, 499052437687091099752102, -165001649542438592233911, 21093471141625840446156, 6156693471826022895131, -4600965843542982603642, 1603715652874305540429, -380816149742034841101, 67078293227571341960, -8020044897494491700, 473228987859384350, 17394125465158663, 11290010198961, -3759562253070, -38805576660, -118729976, 97127, 966, 1]

def poly_from_coeff(v):
    n = len(v)-1
    return sum(ZZ(c)*x^(n-i) for i,c in enumerate(v))

M2 = poly_from_coeff(M2_coeff)
M3 = poly_from_coeff(M3_coeff)
M4 = poly_from_coeff(M4_coeff)

# Special/core and universal transparent values:
m_axis = 17*x^2 - 15*x - 1       # A[g,0]=A[0,g]=A[g,g], g != 0
m_00   = 17*x^2 - 49*x + 31      # A[0,0]
m_dinv = x^2 + 17*x - 1          # delta^(-1)
m_dmh  = x^4 + 17*x^2 - 1        # delta^(-1/2), positive root
m_one  = x - 1

print("P2 irreducible over Q(delta):", P2.is_irreducible())
print("P3 irreducible over Q(delta):", P3.is_irreducible())
print("P4 irreducible over Q(delta):", P4.is_irreducible())
print("M2 irreducible over Q:", M2.is_irreducible())
print("M3 irreducible over Q:", M3.is_irreducible())
print("M4 irreducible over Q:", M4.is_irreducible())

print("P2 =", P2)
print("P3 =", P3)
print("P4 =", P4)
print("M2 =", M2)
print("M3 =", M3)
print("M4 =", M4)

# Relation between P_t and the actual A entry:
# If a=A[g,h] is generic of type t, then b=(delta-1)*a satisfies P_t(b)=0.
# Equivalently, over Q(delta), a has monic minimal polynomial
#     P_t((delta-1)*x)/(delta-1)^16.
