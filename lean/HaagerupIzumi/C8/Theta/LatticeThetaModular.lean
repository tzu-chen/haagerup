module

public import HaagerupIzumi.C8.Theta.LatticeThetaHolomorphic
public import Mathlib.LinearAlgebra.Matrix.FixedDetMatrices
public import Mathlib.Analysis.Complex.UpperHalfPlane.MoebiusAction

@[expose] public section

/-!
# From the `S`- and `T`-laws to `SL₂(ℤ)`-covariance

Part of work item W6 (`C8/ROADMAP.md`).  `pole_cancellation` (`Analytic/PoleCancellation.lean`,
Lemma `lem:pole-cancellation`, manuscript lines 3599–3612) takes vector-valued functions
`F : ℍ → ι → ℂ` with `F (γ • τ) = σ(γ) *ᵥ F τ` for **all** `γ ∈ SL(2, ℤ)`.  The theta
identities of `LatticeTheta` / `LatticeThetaHarmonic` give the laws for the generators
`S, T` only.  `covariant_of_S_T` closes that gap **given** a group homomorphism
`σ : SL(2, ℤ) → GL(ι, ℂ)` whose values at `S` and `T` are the theta matrices: since
`SL(2, ℤ)` is generated by `S` and `T` (Mathlib's `SpecialLinearGroup.SL2Z_generators`),
covariance under `S` and `T` implies covariance under every `γ`.  The homomorphism `σ` itself
is not constructed here; it comes from the VOA side (modularity of the character vector,
W6 plan item 4), and the theta `S`-matrix must be taken in the `e(-(γ, δ))` form
(see the docstring of `LatticeTheta`).

`coe_S_smul`, `coe_T_smul` translate between the action on `ℍ` and the formulas
`τ ↦ -1/τ`, `τ ↦ τ + 1` used in the theta files.

Nothing here is an external hypothesis; everything is proved.
-/

noncomputable section

open Complex Matrix ModularGroup
open scoped MatrixGroups UpperHalfPlane

namespace HaagerupIzumi.C8
namespace Theta

/-- **Generator reduction.**  If `F : ℍ → ι → ℂ` satisfies `F (S • τ) = σ(S) F(τ)` and
`F (T • τ) = σ(T) F(τ)` for a homomorphism `σ : SL(2, ℤ) → GL(ι, ℂ)`, then
`F (γ • τ) = σ(γ) F(τ)` for all `γ ∈ SL(2, ℤ)`. -/
theorem covariant_of_S_T {ι : Type*} [Fintype ι] [DecidableEq ι]
    (σ : SL(2, ℤ) →* Matrix.GeneralLinearGroup ι ℂ) (F : ℍ → ι → ℂ)
    (hS : ∀ τ : ℍ, F (S • τ) = (σ S : Matrix ι ι ℂ) *ᵥ F τ)
    (hT : ∀ τ : ℍ, F (T • τ) = (σ T : Matrix ι ι ℂ) *ᵥ F τ) :
    ∀ (γ : SL(2, ℤ)) (τ : ℍ), F (γ • τ) = (σ γ : Matrix ι ι ℂ) *ᵥ F τ := by
  intro γ
  have hγ : γ ∈ Subgroup.closure ({S, T} : Set SL(2, ℤ)) := by
    rw [SpecialLinearGroup.SL2Z_generators]
    exact Subgroup.mem_top γ
  induction hγ using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact hS
    · exact hT
  | one =>
    intro τ
    rw [one_smul, map_one, Units.val_one, one_mulVec]
  | mul x y _ _ hx hy =>
    intro τ
    rw [mul_smul, hx, hy, mulVec_mulVec, map_mul, Units.val_mul]
  | inv x _ hx =>
    intro τ
    have h := hx (x⁻¹ • τ)
    rw [smul_inv_smul] at h
    rw [h, mulVec_mulVec, ← Units.val_mul, ← map_mul, inv_mul_cancel, map_one, Units.val_one,
      one_mulVec]

/-- `S • τ = -1/τ`. -/
theorem coe_S_smul (τ : ℍ) : ((S • τ : ℍ) : ℂ) = -1 / (τ : ℂ) := by
  rw [UpperHalfPlane.modular_S_smul, UpperHalfPlane.coe_mk, inv_neg, neg_div, one_div]

/-- `T • τ = τ + 1`. -/
theorem coe_T_smul (τ : ℍ) : ((T • τ : ℍ) : ℂ) = (τ : ℂ) + 1 := by
  rw [UpperHalfPlane.modular_T_smul, UpperHalfPlane.coe_vadd]
  push_cast
  ring

end Theta
end HaagerupIzumi.C8

#print axioms HaagerupIzumi.C8.Theta.covariant_of_S_T
#print axioms HaagerupIzumi.C8.Theta.coe_S_smul
#print axioms HaagerupIzumi.C8.Theta.coe_T_smul
