module

public import Mathlib.Analysis.InnerProductSpace.LinearPMap

@[expose] public section

/-! # Reduction on a common core (`lem:analytic-graph-reduction`)

This file formalizes Lemma `lem:analytic-graph-reduction` (Reduction on a common core,
`haagerup_c8_expanded.tex`, lines 4454–4474), using Mathlib's unbounded operators
`LinearPMap`.

Let `T₀ : D → 𝒦` be closable and `P` a bounded operator with `P D ⊆ D` and
`T₀ P ξ = P T₀ ξ` for `ξ ∈ D`.

* `closure_map_mem_domain`: `P` maps the domain of `T = closure T₀` into itself and
  `T P ξ = P T ξ` there.  The proof is the graph-closure argument of the manuscript:
  `(ξ, Tξ) ↦ (Pξ, PTξ)` is continuous and preserves the graph of `T₀`, hence its closure.
* `closure_sub_map_mem_domain`: the same for `1 - P`, so `T` is the direct sum of its
  restrictions to `P𝒦` and `(1-P)𝒦`.
* `adjoint_map_mem_domain`: let `S` be densely defined, `P` a map of the source preserving
  `S.domain` with `S P = Q S` there, and `P', Q'` formal adjoints of `P, Q`
  (`⟪P' a, b⟫ = ⟪a, P b⟫`, `⟪Q' a, b⟫ = ⟪a, Q b⟫`).  Then `Q'` preserves the domain of
  the adjoint `S†` and `S† Q' = P' S†` there.  No boundedness is needed for this step.
* `graphReduction`: both statements for `T = closure T₀` and its adjoint `T†`
  (Mathlib's `LinearPMap.adjoint`, the manuscript's `T*`), for a bounded symmetric `P`
  (e.g. an orthogonal projection).  No assertion that `D` is a core for `T*` is needed.

The manuscript applies this to the orthogonal summand projections of `H↓_U` and of a
reconstructed sector; the hypotheses `P D ⊆ D` and `T₀ P = P T₀` on the finite-energy
core are verified there from the VOA data (unitary invariance identity, ordinaryness of
the summand), which are not formalized here.  The final sentence of the lemma (that `P`
commutes with the von Neumann algebra generated by `T`, via the polar decomposition and
the spectral projections of `|T|`) is not formalized: Mathlib has no polar decomposition
for closed unbounded operators.
-/

namespace HaagerupIzumi.C8

open LinearPMap

section Closure

variable {R E F : Type*} [CommRing R] [AddCommGroup E] [AddCommGroup F] [Module R E]
  [Module R F] [TopologicalSpace E] [TopologicalSpace F] [ContinuousAdd E] [ContinuousAdd F]
  [TopologicalSpace R] [ContinuousSMul R E] [ContinuousSMul R F]

omit [ContinuousAdd E] [ContinuousAdd F] [TopologicalSpace R] [ContinuousSMul R E]
  [ContinuousSMul R F] in
/-- The continuous map `P × Q` preserves the graph of `T` when `P` preserves the domain and
`T P = Q T` on it. -/
theorem mapsTo_graph {T : E →ₗ.[R] F} (P : E →L[R] E) (Q : F →L[R] F)
    (hdom : ∀ x ∈ T.domain, P x ∈ T.domain)
    (hcomm : ∀ x : T.domain, T ⟨P x, hdom x x.2⟩ = Q (T x)) :
    Set.MapsTo (Prod.map P Q) (T.graph : Set (E × F)) (T.graph : Set (E × F)) := by
  intro p hp
  rw [SetLike.mem_coe] at hp ⊢
  obtain ⟨y, hy⟩ := (mem_graph_iff' T).1 hp
  subst hy
  exact (mem_graph_iff' T).2 ⟨⟨P y, hdom y y.2⟩, Prod.ext rfl (hcomm y)⟩

/-- **Graph reduction, closure step** (`lem:analytic-graph-reduction`, lines 4467–4469).
If `T₀` is closable, `P T₀.domain ⊆ T₀.domain` and `T₀ P = Q T₀` on `T₀.domain`, with `P, Q`
continuous linear, then `P` maps the domain of `closure T₀` into itself and
`closure T₀ (P ξ) = Q (closure T₀ ξ)`. -/
theorem closure_map_mem_domain {T : E →ₗ.[R] F} (hT : T.IsClosable) (P : E →L[R] E)
    (Q : F →L[R] F) (hdom : ∀ x ∈ T.domain, P x ∈ T.domain)
    (hcomm : ∀ x : T.domain, T ⟨P x, hdom x x.2⟩ = Q (T x)) (x : T.closure.domain) :
    ∃ hPx : P x ∈ T.closure.domain, T.closure ⟨P x, hPx⟩ = Q (T.closure x) := by
  have hx : ((x : E), T.closure x) ∈ closure (T.graph : Set (E × F)) := by
    rw [← Submodule.topologicalClosure_coe, hT.graph_closure_eq_closure_graph, SetLike.mem_coe]
    exact T.closure.mem_graph x
  have himg := map_mem_closure (P.continuous.prodMap Q.continuous) hx
    (mapsTo_graph P Q hdom hcomm)
  rw [← Submodule.topologicalClosure_coe, hT.graph_closure_eq_closure_graph, SetLike.mem_coe,
    mem_graph_iff] at himg
  obtain ⟨w, hw1, hw2⟩ := himg
  have hw1' : (w : E) = P x := hw1
  have hPx : P x ∈ T.closure.domain := by
    rw [← hw1']
    exact w.2
  refine ⟨hPx, ?_⟩
  have hw : w = ⟨P x, hPx⟩ := Subtype.ext hw1'
  rw [← hw]
  exact hw2

/-- The same statement for `1 - P`: together with `closure_map_mem_domain` this says that
`closure T₀` is the direct sum of its restrictions to the ranges of `P` and `1 - P`. -/
theorem closure_sub_map_mem_domain {T : E →ₗ.[R] F} (hT : T.IsClosable) (P : E →L[R] E)
    (Q : F →L[R] F) (hdom : ∀ x ∈ T.domain, P x ∈ T.domain)
    (hcomm : ∀ x : T.domain, T ⟨P x, hdom x x.2⟩ = Q (T x)) (x : T.closure.domain) :
    ∃ h : (x : E) - P x ∈ T.closure.domain,
      T.closure ⟨(x : E) - P x, h⟩ = T.closure x - Q (T.closure x) := by
  obtain ⟨hPx, hTPx⟩ := closure_map_mem_domain hT P Q hdom hcomm x
  refine ⟨T.closure.domain.sub_mem x.2 hPx, ?_⟩
  have hsub : (⟨(x : E) - P x, T.closure.domain.sub_mem x.2 hPx⟩ : T.closure.domain) =
      x - ⟨P x, hPx⟩ := rfl
  rw [hsub, LinearPMap.map_sub, hTPx]

end Closure

section Adjoint

variable {𝕜 E F : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
  [NormedAddCommGroup F] [InnerProductSpace 𝕜 F] [CompleteSpace E]

/-- **Graph reduction, adjoint step** (`lem:analytic-graph-reduction`, line 4471).
Let `S` be densely defined, `P, P'` maps of the source and `Q, Q'` maps of the target with
`⟪P' a, b⟫ = ⟪a, P b⟫` and `⟪Q' a, b⟫ = ⟪a, Q b⟫`.  If `P` preserves `S.domain` and
`S P = Q S` there, then `Q'` preserves the domain of `S†` and `S† Q' = P' S†` there. -/
theorem adjoint_map_mem_domain {S : E →ₗ.[𝕜] F} (hS : Dense (S.domain : Set E))
    (P P' : E → E) (Q Q' : F → F)
    (hP : ∀ a b, inner 𝕜 (P' a) b = inner 𝕜 a (P b))
    (hQ : ∀ a b, inner 𝕜 (Q' a) b = inner 𝕜 a (Q b))
    (hdom : ∀ x ∈ S.domain, P x ∈ S.domain)
    (hcomm : ∀ x : S.domain, S ⟨P x, hdom x x.2⟩ = Q (S x)) (y : S†.domain) :
    ∃ hy : Q' y ∈ S†.domain, S† ⟨Q' y, hy⟩ = P' (S† y) := by
  have key : ∀ x : S.domain, inner 𝕜 (P' (S† y)) (x : E) = inner 𝕜 (Q' (y : F)) (S x) := by
    intro x
    rw [hP, hQ, ← hcomm x]
    exact adjoint_isFormalAdjoint hS y ⟨P x, hdom x x.2⟩
  have hy : Q' y ∈ S†.domain := mem_adjoint_domain_of_exists _ ⟨_, key⟩
  exact ⟨hy, adjoint_apply_eq hS ⟨Q' y, hy⟩ key⟩

/-- **Lemma `lem:analytic-graph-reduction`** (lines 4454–4474), operator-theoretic part.
Let `T₀` be densely defined and closable, and `P` a bounded symmetric operator
(e.g. an orthogonal projection) with `P D ⊆ D` and `T₀ P = P T₀` on `D = T₀.domain`.
Then `P` reduces `T = closure T₀` and `T†`: both domains are `P`-invariant and
`T P = P T`, `T† P = P T†` on them. -/
theorem graphReduction {T : E →ₗ.[𝕜] E} (hT : T.IsClosable) (hTd : Dense (T.domain : Set E))
    (P : E →L[𝕜] E) (hP : ∀ a b, inner 𝕜 (P a) b = inner 𝕜 a (P b))
    (hdom : ∀ x ∈ T.domain, P x ∈ T.domain)
    (hcomm : ∀ x : T.domain, T ⟨P x, hdom x x.2⟩ = P (T x)) :
    (∀ x : T.closure.domain,
      ∃ h : P x ∈ T.closure.domain, T.closure ⟨P x, h⟩ = P (T.closure x)) ∧
    (∀ y : (T.closure)†.domain,
      ∃ h : P y ∈ (T.closure)†.domain, (T.closure)† ⟨P y, h⟩ = P ((T.closure)† y)) := by
  have hcl := closure_map_mem_domain hT P P hdom hcomm
  refine ⟨hcl, fun y => ?_⟩
  have hTd' : Dense (T.closure.domain : Set E) :=
    hTd.mono fun z hz => T.le_closure.1 hz
  exact adjoint_map_mem_domain hTd' P P P P hP hP (fun x hx => (hcl ⟨x, hx⟩).1)
    (fun x => (hcl x).2) y

end Adjoint

end HaagerupIzumi.C8

#print axioms HaagerupIzumi.C8.closure_map_mem_domain
#print axioms HaagerupIzumi.C8.closure_sub_map_mem_domain
#print axioms HaagerupIzumi.C8.adjoint_map_mem_domain
#print axioms HaagerupIzumi.C8.graphReduction
