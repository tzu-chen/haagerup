module

public import HaagerupIzumi.C8.ProofMap
public import HaagerupIzumi.C8.InitialGrades

@[expose] public section

/-!
# The properness branch of the proof map, discharged

`ProofMap.lean` records the whole argument with opaque nodes.  For the properness branch
(Appendices A–E) the nodes have concrete Lean meanings, and the four manuscript-lemma arrows

* `L_gates : certFiniteClosure → closureHyps` (Gates 4, 5, Lemma `lem:bootstrap`),
* `L_recursive : closureHyps → strongGen` (Theorem `thm:recursive`),
* `L_weightOne : strongGen → certDimensions → weightOne`,
* `L_proper : weightOne → certDimensions → proper`,

are theorems.  `concreteNodes R D u` replaces the properness nodes of an arbitrary `R : Nodes`
by their concrete statements about the lattice VOA `A`, the closure data `D` and the field `u`;
`properness_arrows` proves the four arrows for it.  Hence in `Inputs (concreteNodes R D u)`
these four fields need not be assumed.
-/

namespace HaagerupIzumi.C8.ProofMap

open HaagerupIzumi.C8 ClosureData

variable {k : Type*} [Field k] [CharZero k] {V : Type*} [AddCommGroup V] [Module k V]
variable {A : VertexOperatorAlgebra k V}

/-- The finite closure certificates, as one proposition. -/
def certFiniteClosureProp (D : ClosureData A) (u : V) : Prop :=
  LowerCertificate D ∧ (∃ G : Gate4Certificate D, Nonempty (Gate5Certificate D G)) ∧
    (∀ w : List Bool, w.length = 25 → ∀ v ∈ D.S₃,
      CFT.raisingWord (A.mode 0 D.eL) (A.mode 0 D.eR) w v = 0) ∧
    (∀ w : List Bool, w.length = 25 → ∀ v ∈ D.S₃,
      CFT.raisingWord (A.mode 0 D.fL) (A.mode 0 D.fR) w v = 0) ∧
    A.ω ∈ D.S₂ ∧ u ∈ D.S₂ ∧ D.S₂ ≤ D.U u

/-- The two hypotheses of Theorem `thm:recursive` for the closure family (with the data
needed to identify `⟨K, ω, u⟩` with the algebra generated by the family). -/
def closureHypsProp (D : ClosureData A) (u : V) : Prop :=
  (∀ x, x ∈ D.family 1 ∨ x ∈ D.family 2 → ∀ d, ∀ s ∈ D.family d, ∀ n : ℕ,
      A.mode n x s ∈ A.normalSpan (⋃ e, (D.family e : Set V))) ∧
    (∀ d, 3 ≤ d → d ≤ 4 →
      D.family d ≤ Submodule.span k {x | ∃ a ∈ D.family 2, ∃ b ∈ D.family (d - 1),
          x = A.mode 0 a b} ⊔
        (A.normalSpan (⋃ e, ⋃ (_ : e < d), (D.family e : Set V)) ⊓ A.grade d)) ∧
    LowerCertificate D ∧ A.ω ∈ D.S₂ ∧ u ∈ D.S₂ ∧ D.S₂ ≤ D.U u

/-- The proof map with its properness nodes made concrete. -/
def concreteNodes (R : Nodes) (D : ClosureData A) (u : V) : Nodes :=
  { R with
    certFiniteClosure := certFiniteClosureProp D u
    certDimensions := Module.finrank k D.K = 6 ∧ Module.finrank k (A.grade 1) = 86
    closureHyps := closureHypsProp D u
    strongGen := D.U u = A.normalSpan (⋃ d, (D.family d : Set V))
    weightOne := D.U u ⊓ A.grade 1 = D.K ∧ Module.finrank k D.K = 6
    proper := D.U u ≠ ⊤ }

/-- **The four properness arrows of the proof map are theorems.** -/
theorem properness_arrows (R : Nodes) (D : ClosureData A) (u : V) :
    ((concreteNodes R D u).certFiniteClosure → (concreteNodes R D u).closureHyps) ∧
    ((concreteNodes R D u).closureHyps → (concreteNodes R D u).strongGen) ∧
    ((concreteNodes R D u).strongGen → (concreteNodes R D u).certDimensions →
      (concreteNodes R D u).weightOne) ∧
    ((concreteNodes R D u).weightOne → (concreteNodes R D u).certDimensions →
      (concreteNodes R D u).proper) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rintro ⟨L, ⟨G, ⟨G5⟩⟩, hnilE, hnilF, hω, hu, hmin⟩
    exact ⟨closure_hypothesis_one D L G G5 hnilE hnilF, closure_hypothesis_two D L, L, hω, hu,
      hmin⟩
  · rintro ⟨h1, h2, L, hω, hu, hmin⟩
    obtain ⟨_, hgen, _⟩ := A.toVertexAlgebra.recursive_strong_generation D.family 4
      (closure_family_grade D) (closure_family_top D) h1 h2
    change D.U u = A.normalSpan (⋃ d, (D.family d : Set V))
    rw [generated_eq_family D L u hω hu hmin]
    exact hgen
  · intro hU hdim
    change D.U u = A.normalSpan (⋃ d, (D.family d : Set V)) at hU
    refine ⟨?_, hdim.1⟩
    rw [hU]
    exact A.toVertexAlgebra.normalSpan_iUnion_inf_grade_one D.family_grade
  · rintro ⟨h1, hK⟩ ⟨_, hB⟩ htop
    rw [htop, top_inf_eq] at h1
    have : Module.finrank k (A.grade 1) = Module.finrank k D.K := by rw [h1]
    omega

#print axioms properness_arrows

end HaagerupIzumi.C8.ProofMap
