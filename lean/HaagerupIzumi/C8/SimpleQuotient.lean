module

public import HaagerupIzumi.C8.VertexAlgebra.Basic
public import Mathlib.LinearAlgebra.Isomorphisms

@[expose] public section

/-!
# Uniqueness of a simple graded quotient (Proposition `prop:pf13-finite-reconstruction`)

The final step of Proposition `prop:pf13-finite-reconstruction` (lines 2815–2826 of the
expanded draft) reads: take the vertex subalgebra `D ⊂ V × V'` generated by the diagonal
pairs of the named fields; it is of CFT type, so it has a unique maximal proper graded
ideal; the two coordinate projections are surjective and grading preserving, with kernels
that are maximal proper graded ideals because `V, V'` are simple; hence the kernels
coincide, which gives `V ≅ V'`.

This file proves that step for the shared interface `VertexAlgebra` (whose grading is of CFT
type, `D₀ = k·1`):

* `ker_isGraded` — the kernel of a grading-preserving map is graded;
* `vac_not_mem_sup_ker` — the vacuum is not in the sum of the two kernels;
* `ker_eq_ker_of_simple` — the two kernels coincide;
* `simple_quotient_unique` — there is a linear equivalence `φ : V₁ ≃ V₂` with
  `φ ∘ π₁ = π₂`, preserving the vacuum and all modes.

No freeness or independence of normal monomials is used, as in the manuscript.  The facts
that `D` is the differential normal span of the diagonal generators (common polynomial OPE
closure plus filtered Wick induction), and that `L, a` generate each target, are the
inputs supplying the hypotheses `D` of CFT type and `π₁, π₂` surjective.
-/

namespace HaagerupIzumi.C8.SimpleQuotient

open HaagerupIzumi.C8

variable {k : Type*} [Field k]
variable {D : Type*} [AddCommGroup D] [Module k D]

/-- A two-sided ideal of a vertex algebra: closed under all modes on either side. -/
def IsIdeal (A : VertexAlgebra k D) (I : Submodule k D) : Prop :=
  ∀ (n : ℤ) (a v : D), v ∈ I → A.mode n a v ∈ I ∧ A.mode n v a ∈ I

/-- A simple vertex algebra: nonzero vacuum, and every ideal is `⊥` or `⊤`. -/
def IsSimple (A : VertexAlgebra k D) : Prop :=
  A.vac ≠ 0 ∧ ∀ I : Submodule k D, IsIdeal A I → I = ⊥ ∨ I = ⊤

/-- A grading-preserving homomorphism of vertex algebras. -/
structure IsGradedHom {V : Type*} [AddCommGroup V] [Module k V]
    (A : VertexAlgebra k D) (B : VertexAlgebra k V) (π : D →ₗ[k] V) : Prop where
  map_vac : π A.vac = B.vac
  map_mode : ∀ (n : ℤ) (a b : D), π (A.mode n a b) = B.mode n (π a) (π b)
  map_grade : ∀ (d : ℕ) (x : D), x ∈ A.grade d → π x ∈ B.grade d

variable {V₁ V₂ : Type*} [AddCommGroup V₁] [Module k V₁] [AddCommGroup V₂] [Module k V₂]

/-- The homogeneous components of `x` (through the internal direct sum). -/
noncomputable def comp (A : VertexAlgebra k D) (x : D) (d : ℕ) : D :=
  ((LinearEquiv.ofBijective (DirectSum.coeLinearMap A.grade) A.grade_internal).symm x d : D)

theorem comp_mem (A : VertexAlgebra k D) (x : D) (d : ℕ) : comp A x d ∈ A.grade d :=
  ((LinearEquiv.ofBijective (DirectSum.coeLinearMap A.grade) A.grade_internal).symm x d).2

theorem comp_add (A : VertexAlgebra k D) (x y : D) (d : ℕ) :
    comp A (x + y) d = comp A x d + comp A y d := by
  simp [comp]

theorem comp_of_mem (A : VertexAlgebra k D) {x : D} {d : ℕ} (hx : x ∈ A.grade d) :
    comp A x d = x := by
  simp [comp, DirectSum.IsInternal.ofBijective_coeLinearMap_of_mem A.grade_internal hx]

/-- **The kernel of a grading-preserving homomorphism is graded**: every homogeneous component
of an element of the kernel lies in the kernel. -/
theorem ker_isGraded (A : VertexAlgebra k D) (B : VertexAlgebra k V₁) {π : D →ₗ[k] V₁}
    (hπ : IsGradedHom A B π) {x : D} (hx : π x = 0) (d : ℕ) : π (comp A x d) = 0 := by
  classical
  set e := LinearEquiv.ofBijective (DirectSum.coeLinearMap A.grade) A.grade_internal
  set c := e.symm x
  -- the image components, as an element of the direct sum for `B`
  let c' : DirectSum ℕ fun i => B.grade i :=
    DFinsupp.mapRange (fun i (y : A.grade i) => (⟨π y, hπ.map_grade i y y.2⟩ : B.grade i))
      (fun i => by ext; simp) c
  have hsum : DirectSum.coeLinearMap B.grade c' = π x := by
    have hx' : x = DirectSum.coeLinearMap A.grade c := (e.apply_symm_apply x).symm
    conv_rhs => rw [hx']
    rw [DirectSum.coeLinearMap_eq_dfinsuppSum, DirectSum.coeLinearMap_eq_dfinsuppSum,
      map_dfinsuppSum, DFinsupp.sum_mapRange_index (fun i => by simp)]
  have hzero : c' = 0 := by
    apply B.grade_internal.injective
    change DirectSum.coeLinearMap B.grade c' = DirectSum.coeLinearMap B.grade 0
    rw [hsum, hx, map_zero]
  have := congrArg (fun z : DirectSum ℕ fun i => B.grade i => (z d : V₁)) hzero
  simpa [c', c, e, comp] using this

/-- In a vertex algebra of CFT type, the vacuum is not in the sum of two kernels of
grading-preserving homomorphisms onto algebras with nonzero vacuum. -/
theorem vac_not_mem_sup_ker (A : VertexAlgebra k D) (B₁ : VertexAlgebra k V₁)
    (B₂ : VertexAlgebra k V₂) {π₁ : D →ₗ[k] V₁} {π₂ : D →ₗ[k] V₂}
    (h₁ : IsGradedHom A B₁ π₁) (h₂ : IsGradedHom A B₂ π₂) (hv₁ : B₁.vac ≠ 0) (hv₂ : B₂.vac ≠ 0) :
    A.vac ∉ LinearMap.ker π₁ ⊔ LinearMap.ker π₂ := by
  intro hmem
  obtain ⟨j₁, hj₁, j₂, hj₂, hsum⟩ := Submodule.mem_sup.1 hmem
  have hvac0 : A.vac ∈ A.grade 0 := by rw [A.grade_zero]; exact Submodule.mem_span_singleton_self _
  -- degree-zero components
  have hc : comp A j₁ 0 + comp A j₂ 0 = A.vac := by
    rw [← comp_add, hsum, comp_of_mem A hvac0]
  have hj₁0 : comp A j₁ 0 ∈ k ∙ A.vac := by rw [← A.grade_zero]; exact comp_mem A j₁ 0
  have hj₂0 : comp A j₂ 0 ∈ k ∙ A.vac := by rw [← A.grade_zero]; exact comp_mem A j₂ 0
  obtain ⟨c₁, hc₁⟩ := Submodule.mem_span_singleton.1 hj₁0
  obtain ⟨c₂, hc₂⟩ := Submodule.mem_span_singleton.1 hj₂0
  have hk₁ : π₁ (comp A j₁ 0) = 0 := ker_isGraded A B₁ h₁ (LinearMap.mem_ker.1 hj₁) 0
  have hk₂ : π₂ (comp A j₂ 0) = 0 := ker_isGraded A B₂ h₂ (LinearMap.mem_ker.1 hj₂) 0
  rw [← hc₁, map_smul, h₁.map_vac] at hk₁
  rw [← hc₂, map_smul, h₂.map_vac] at hk₂
  have hc₁0 : c₁ = 0 := by
    by_contra hne
    apply hv₁
    calc B₁.vac = c₁⁻¹ • (c₁ • B₁.vac) := by rw [smul_smul, inv_mul_cancel₀ hne, one_smul]
      _ = 0 := by rw [hk₁, smul_zero]
  have hc₂0 : c₂ = 0 := by
    by_contra hne
    apply hv₂
    calc B₂.vac = c₂⁻¹ • (c₂ • B₂.vac) := by rw [smul_smul, inv_mul_cancel₀ hne, one_smul]
      _ = 0 := by rw [hk₂, smul_zero]
  rw [← hc₁, ← hc₂, hc₁0, hc₂0] at hc
  simp only [zero_smul, add_zero] at hc
  -- now `A.vac = 0`, so `π₁` kills the vacuum
  have : B₁.vac = 0 := by rw [← h₁.map_vac, ← hc, map_zero]
  exact hv₁ this

/-- The image of an ideal under a surjective homomorphism is an ideal. -/
theorem isIdeal_map (A : VertexAlgebra k D) (B : VertexAlgebra k V₁) {π : D →ₗ[k] V₁}
    (hπ : IsGradedHom A B π) (hsurj : Function.Surjective π) {J : Submodule k D}
    (hJ : IsIdeal A J) : IsIdeal B (J.map π) := by
  intro n a w hw
  obtain ⟨j, hj, rfl⟩ := Submodule.mem_map.1 hw
  obtain ⟨x, rfl⟩ := hsurj a
  refine ⟨?_, ?_⟩
  · rw [← hπ.map_mode]; exact Submodule.mem_map_of_mem (hJ n x j hj).1
  · rw [← hπ.map_mode]; exact Submodule.mem_map_of_mem (hJ n x j hj).2

/-- Kernels of homomorphisms are ideals. -/
theorem isIdeal_ker (A : VertexAlgebra k D) (B : VertexAlgebra k V₁) {π : D →ₗ[k] V₁}
    (hπ : IsGradedHom A B π) : IsIdeal A (LinearMap.ker π) := by
  intro n a v hv
  rw [LinearMap.mem_ker] at hv
  refine ⟨?_, ?_⟩ <;> rw [LinearMap.mem_ker, hπ.map_mode, hv] <;> simp

/-- One inclusion of kernels. -/
theorem ker_le_ker (A : VertexAlgebra k D) (B₁ : VertexAlgebra k V₁) (B₂ : VertexAlgebra k V₂)
    {π₁ : D →ₗ[k] V₁} {π₂ : D →ₗ[k] V₂} (h₁ : IsGradedHom A B₁ π₁) (h₂ : IsGradedHom A B₂ π₂)
    (s₁ : Function.Surjective π₁) (simple₁ : IsSimple B₁) (hv₂ : B₂.vac ≠ 0) :
    LinearMap.ker π₂ ≤ LinearMap.ker π₁ := by
  rcases simple₁.2 _ (isIdeal_map A B₁ h₁ s₁ (isIdeal_ker A B₂ h₂)) with hbot | htop
  · intro x hx
    have : π₁ x ∈ (LinearMap.ker π₂).map π₁ := Submodule.mem_map_of_mem hx
    rw [hbot] at this
    exact (Submodule.mem_bot k).1 this
  · exfalso
    have hvac : B₁.vac ∈ (LinearMap.ker π₂).map π₁ := by rw [htop]; trivial
    obtain ⟨j, hj, hjv⟩ := Submodule.mem_map.1 hvac
    apply vac_not_mem_sup_ker A B₁ B₂ h₁ h₂ simple₁.1 hv₂
    have hdiff : A.vac - j ∈ LinearMap.ker π₁ := by
      rw [LinearMap.mem_ker, map_sub, hjv, h₁.map_vac, sub_self]
    have := Submodule.add_mem_sup hdiff hj
    simpa using this

/-- **The kernels coincide.** -/
theorem ker_eq_ker_of_simple (A : VertexAlgebra k D) (B₁ : VertexAlgebra k V₁)
    (B₂ : VertexAlgebra k V₂) {π₁ : D →ₗ[k] V₁} {π₂ : D →ₗ[k] V₂}
    (h₁ : IsGradedHom A B₁ π₁) (h₂ : IsGradedHom A B₂ π₂)
    (s₁ : Function.Surjective π₁) (s₂ : Function.Surjective π₂)
    (simple₁ : IsSimple B₁) (simple₂ : IsSimple B₂) :
    LinearMap.ker π₁ = LinearMap.ker π₂ :=
  le_antisymm (ker_le_ker A B₂ B₁ h₂ h₁ s₂ simple₂ simple₁.1)
    (ker_le_ker A B₁ B₂ h₁ h₂ s₁ simple₁ simple₂.1)

/-- **Uniqueness of the simple quotient.**  Two surjective grading-preserving homomorphisms
from a vertex algebra of CFT type onto simple vertex algebras differ by an isomorphism of
vertex algebras. -/
theorem simple_quotient_unique (A : VertexAlgebra k D) (B₁ : VertexAlgebra k V₁)
    (B₂ : VertexAlgebra k V₂) {π₁ : D →ₗ[k] V₁} {π₂ : D →ₗ[k] V₂}
    (h₁ : IsGradedHom A B₁ π₁) (h₂ : IsGradedHom A B₂ π₂)
    (s₁ : Function.Surjective π₁) (s₂ : Function.Surjective π₂)
    (simple₁ : IsSimple B₁) (simple₂ : IsSimple B₂) :
    ∃ φ : V₁ ≃ₗ[k] V₂, (∀ x, φ (π₁ x) = π₂ x) ∧ φ B₁.vac = B₂.vac ∧
      ∀ (n : ℤ) (a b : V₁), φ (B₁.mode n a b) = B₂.mode n (φ a) (φ b) := by
  have hker := ker_eq_ker_of_simple A B₁ B₂ h₁ h₂ s₁ s₂ simple₁ simple₂
  let φ : V₁ ≃ₗ[k] V₂ := (π₁.quotKerEquivOfSurjective s₁).symm.trans
    ((Submodule.quotEquivOfEq _ _ hker).trans (π₂.quotKerEquivOfSurjective s₂))
  have hφ : ∀ x, φ (π₁ x) = π₂ x := by
    intro x
    simp [φ]
  refine ⟨φ, hφ, ?_, ?_⟩
  · rw [← h₁.map_vac, hφ, h₂.map_vac]
  · intro n a b
    obtain ⟨x, rfl⟩ := s₁ a
    obtain ⟨y, rfl⟩ := s₁ b
    rw [← h₁.map_mode, hφ, hφ, hφ, h₂.map_mode]

#print axioms simple_quotient_unique

end HaagerupIzumi.C8.SimpleQuotient
