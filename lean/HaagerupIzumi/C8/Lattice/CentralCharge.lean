theorem omega3_terms : ∀ p ∈ omega, mode [(p.1, 1)] 3 omega = smul (omegaPair p.1) vac := by
  intro p hp
  simp only [omega, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [omega3_0, omega3_1, omega3_2, omega3_3, omega3_4, omega3_5, omega3_6, omega3_7, omega3_8, omega3_9, omega3_10, omega3_11, omega3_12, omega3_13, omega3_14, omega3_15, omega3_16, omega3_17, omega3_18, omega3_19, omega3_20, omega3_21, omega3_22, omega3_23]

theorem omega_sum : (omega.map fun p => p.2 * omegaPair p.1).sum = 4 := by
  decide +kernel

/-- **`ω_(3) ω = 4 𝟏`** (the central-charge term `c/2` of `L(2) ω`, with `c = 8`). -/
theorem central_charge : Y (toFock omega) 3 (toFock omega) = (4 : ℚ) • toFock vac := by
  rw [Y_toFock_eq_of_terms omega omega 3 vac omegaPair omega3_terms, omega_sum]

