/-!
# The weight-four triplet `q₊, q₀, q₋` as vectors of the Fock model

Generated by `lean/tools/lattice_export/gen_p4.py`.  `p4P`, `p4Z`, `p4M`: the chunks of
`P4_plus`, `P4_zero`, `P4_minus` (`P4Data*.lean`); `qpV`, `q0V`, `qmV` the vectors of `V` (sums of
the chunks).
-/

namespace HaagerupIzumi.C8
namespace LatticeVOA

/-- The chunks of `P4_plus`. -/
noncomputable def p4P : List Vec4 := [p4P_0, p4P_1, p4P_2, p4P_3]

/-- The chunks of `P4_zero`. -/
noncomputable def p4Z : List Vec4 := [p4Z_0, p4Z_1, p4Z_2, p4Z_3]

/-- The chunks of `P4_minus`. -/
noncomputable def p4M : List Vec4 := [p4M_0, p4M_1, p4M_2, p4M_3]

/-- `P4_plus` in `V`. -/
noncomputable def qpV : V := (p4P.map toV4).sum

/-- `P4_zero` in `V`. -/
noncomputable def q0V : V := (p4Z.map toV4).sum

/-- `P4_minus` in `V`. -/
noncomputable def qmV : V := (p4M.map toV4).sum

end LatticeVOA
end HaagerupIzumi.C8
