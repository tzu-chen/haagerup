  (`ProofMapConcreteCharacters.qseries_coeff_eq_zero`).  Uses strict positivity of
  the nonvacuum lowest weights (Lemma `lem:vacuum-projective`), `c = 8` (line 4139) and Zhu/Huang
  modular invariance with Huang's identification of the character `S` with the categorical `S`
  (strong rationality).  The bound `17/10` appears only as a comparison (lines 4189–4190). -/
  L_characters : N.modularData → N.weightOne → N.projectiveVacuum → N.initialGrades →
    N.stronglyRational → N.characterVector ∧ N.lowestWeights
  /-- Corollary `cor:unmixed-lattice-restrictions`; formalized:
  `Characters.unmixed_restriction`, `Characters.unmixed_restriction_two`.  Uses the lattice modules
  `(0, ±1)`, `(±1, 0)` of the discriminant group: weights in `1/3 + ℤ`, `2/3 + ℤ`, top dimensions
  `3`, `27` (lines 4198–4205; `certDiscriminant`). -/
  L_unmixed : N.lowestWeights → N.stronglyRational → N.certDiscriminant → N.unmixedRestrictions
  -- Analytic comparison.
  /-- External: Tener [TenFusion] Corollary 4.24; Tener [TenFields] Proposition 7.5 and
  Lemma 7.6; Longo Theorem 24 (lines 4271–4279). -/
  E_netCR : N.stronglyRational → N.initialGrades → N.netCompletelyRational
  /-- A2.  External: Kawahigashi–Longo Proposition 2.3, CKLW Theorems 6.9, 7.5,
  Proposition 7.6, Lagrangian-center theorem; manuscript: Lemma
  `lem:analytic-graph-reduction` (`graphReduction`: closure and adjoint commutation; the von Neumann
  algebra clause needs polar decomposition and is not formalized) and the rank-six/indicator
  argument applied to
  `𝓕_net`; `eq_scalar_of_commute_of_separating`, `card_eq_three_or_six` (Analytic/NetCount).
  Assumes the algebraic branching and rank-six ring deductions (lines 4293–4294; `H↓U` with
  multiplicities `1, 1, 2` needs `Y ≅ Y*`), and re-derives untwistedness of `𝓕_net` from the
  lattice-net discriminant form (lines 4383–4406). -/
  L_netCount : N.netCompletelyRational → N.branchH → N.noSignExtension →
    N.rankSixRing → N.certDiscriminant → N.netCount
  /-- A3.  External: Henriques–Tener Theorems 8.9, 9.5, Corollary 9.7, Remark 9.8;
  manuscript: graph reduction, energy-domain argument, form comparison (`schur_scalar`,
  `projection_commute_of_formalAdjoint`, Analytic/Comparison).  Uses strong locality and PCT
  of `U` (lines 4449, 4524–4526). -/
  L_reconstruction : N.netCompletelyRational → N.stronglyRational → N.initialGrades →
    N.reconstruction
  /-- Counting: an injection of twelve simples into twelve simples is a bijection
  (`bijective_of_injective_of_card_eq`); the twelve algebraic simples come from the modular
  data (lines 4583–4590). -/
  L_stronglyUnitary : N.reconstruction → N.netCount → N.modularData → N.stronglyUnitary
  /-- A1.  External: Tener [TenFields] (Definitions 3.18, 4.2; Corollaries 3.20–3.22;
  Proposition 4.13; Lemma 3.19); Henriques–Tener [HTAnn] (Remark 4.2, Theorems 5.5, 7.4) and
  [HTNet] (Proposition 4.17, Lemma 6.8, Corollary 6.15, Proposition 6.19, Theorems 8.9, 9.5),
  and Henriques–Tener Lemma 4.15 (the manuscript does not say which paper); Haag duality.
  Applies to the modules reconstructed from sectors (lines 4626–4627) and uses PCT (4836).
  Manuscript: Lemmas `lem:analytic-inverse-domain`,
  `lem:analytic-insertion-continuation`, deck cancellation, the Haag squeeze
  (`analytic_inverse_domain`, `insertion_continuation`, `deck_commute`, `net_eq_of_haagDuality`;
  `AnalyticContinuation.continuation`). -/
  L_annulus : N.reconstruction → N.netCompletelyRational → N.initialGrades → N.annulus
  /-- External: Tener, Definition 2.18 and Corollary 4.6 (positivity of fusion forms). -/
  E_tener : N.stronglyUnitary → N.annulus → N.completelyUnitary
  -- Categorical identifications.
  /-- Lemma `lem:analytic-unitary-all-modules`; external: Gui Theorems 2.21, 2.28, 3.13.  Algebraic core
  formalized: `braidedLeftAct_assoc`, `braidedLeftAct_middle_assoc`, `toBimodFullyFaithful`,
  `tensorBimod_mem_essImage` (Category/). -/
  L_boundaryUnitary : N.completelyUnitary → N.lagrangianCenter → N.boundaryUnitary
  /-- External: Izumi (Definition 2.7, Theorems 5.9, 9.1) for the HI(ℤ/3) ring with untwisted
  pointed part; `H²(ℤ/3, ℂˣ) = ℂˣ/(ℂˣ)³ = 0` (`Fusion.units_cube_surjective`). -/
  E_izumi : N.boundaryUnitary → N.multiplicityOne → N.untwistedPointed → N.boundaryIsHaagerup
  /-- External: Grossman–Snyder Theorem 1.4 (Morita equivalence), DMNO (Lagrangian center),
  Reutter Theorem 5 (unitary braided realization). -/
  E_moritaCenter : N.boundaryIsHaagerup → N.lagrangianCenter → N.completelyUnitary →
    N.repIsCenter
  /-- Corollary `cor:analytic-net-haagerup`: the same external inputs for `𝓕_net`. -/
  E_netCenter : N.netCount → N.netRepIsCenter
  /-- External: Longo–Rehren Theorem 4.9, Longo Theorem 24, DMNO Corollary 4.1 and
  Proposition 4.4, Müger Sections 4 and 8. -/
  E_netExtension : N.netRepIsCenter → N.netCompletelyRational → N.netExtension
  /-- External: Rehren Theorem 1.4, Proposition 1.5, Corollary 1.6.  Identifies all sector
  Hilbert spaces with the twelve ordinary modules (the counting bijection, lines 5089–5091). -/
  E_diagonal : N.netCompletelyRational → N.netCount → N.reconstruction →
    N.characterVector → N.stronglyUnitary → N.diagonalTheory
  /-- External: DMNO, Huang–Kirillov–Lepowsky Theorems 3.2–3.6, Gui's unitary Q-systems,
  Abe–Buhl–Dong Proposition 5.2, Dong–Mason Theorem 1, Müger; manuscript: strict
  positivity of nonvacuum weights (Lemma `lem:vacuum-projective`: `exists_real_nonneg_of_top_trace`,
  `eq_zero_of_top_trace_eq_zero`); `Branching.mu_index_one`.  Assumes the hypotheses of
  `thm:analytic-category` and applies Gui's unitary Q-system theorem (lines 5098, 5130–5136). -/
  E_e8Extension : N.repIsCenter → N.projectiveVacuum → N.stronglyRational →
    N.completelyUnitary → N.e8Extension

variable {N : Nodes}

/-- **Proposition `prop:mainproper`** follows from its inputs. -/
theorem prop_mainproper (I : Inputs N) : N.strongGen ∧ N.weightOne ∧ N.proper := by
  have hgen := I.L_recursive (I.L_gates I.C_finiteClosure)
  have h1 := I.L_weightOne hgen I.C_dimensions
  exact ⟨hgen, h1, I.L_proper h1 I.C_dimensions⟩

theorem initialGrades_of (I : Inputs N) : N.initialGrades :=
  I.E_cklw529 (I.L_recursive (I.L_gates I.C_finiteClosure)) I.C_pct

theorem projectiveVacuum_of (I : Inputs N) : N.projectiveVacuum := by
  have hinit := initialGrades_of I
  have hpos := I.L_positiveStress I.C_structural (I.L_pf13 I.C_structural)
  exact I.L_projectiveVacuum hpos (I.L_c2 hpos hinit) hinit

theorem stronglyRational_of (I : Inputs N) : N.stronglyRational := by
  have hinit := initialGrades_of I
  have hpf := I.L_pf13 I.C_structural
  have hpos := I.L_positiveStress I.C_structural hpf
  have hc2 := I.L_c2 hpos hinit
  have hproj := I.L_projectiveVacuum hpos hc2 hinit
  exact I.L_rational (I.L_rigid hproj hc2 hinit) hc2 hinit

/-- The boundary-ring chain of Appendix G, up to the modular data. -/
theorem boundary_chain (I : Inputs N) :
    N.multiplicityOne ∧ N.twelveTwists ∧ N.modularData ∧ N.untwistedPointed ∧
      N.lagrangianCenter ∧ N.weightOne ∧ N.topBound ∧ N.branchH ∧ N.noSignExtension ∧
      N.rankSixRing := by
  have hgen := I.L_recursive (I.L_gates I.C_finiteClosure)
  have h1 := I.L_weightOne hgen I.C_dimensions
  have hinit := initialGrades_of I
  have hrat := stronglyRational_of I
  have hproj := projectiveVacuum_of I
  have hpf := I.L_pf13 I.C_structural
  have hpos := I.L_positiveStress I.C_structural hpf
  have htop := I.L_topBound I.C_structural hrat hpf hpos hinit
  have hB := I.L_branchB hrat h1 I.C_structural htop I.C_dimensions
  have hH := I.L_branchH hB htop I.C_structural hrat
  have hlag := I.E_dmno hH hrat hproj hB I.C_discriminant
  have hfork := I.L_rankFork hlag hH
  have hinv := I.L_autInvertible hlag I.C_discriminant
  have hsign := I.L_noSign h1 hB hrat
  have h3 := I.L_threeInvertibles hinv hsign hfork hlag
  have hunt := I.L_untwisted h3 I.C_discriminant hlag hrat
  have h4 := I.L_notRankFour hfork h3 hunt h1 hproj hsign hlag hB hrat hinit
  have hring := I.L_rankSixRing hfork h4 h3 hlag hH
  have hmom := I.L_rankSixMoments hring hunt hlag
  have hm1 := I.L_multiplicityOne hmom
  have htw := I.L_twelveTwists hm1 hmom
  exact ⟨hm1, htw, I.E_gsy htw hunt hm1 hlag, hunt, hlag, h1, htop, hH, hsign, hring⟩

/-- **Theorem `thm:main-net`** follows from its inputs: strong rationality, central charge
eight (with unitarity and simplicity: `initialGrades`), strong unitarity, `Rep(𝒩_U) ≃ Z(𝓗₃)`,
the `γ = 0` character vector, the diagonal full net. -/
theorem thm_main_net (I : Inputs N) :
    N.stronglyRational ∧ N.initialGrades ∧ N.stronglyUnitary ∧ N.netCompletelyRational ∧
      N.netRepIsCenter ∧ N.characterVector ∧ N.diagonalTheory := by
  obtain ⟨_, _, hmod, _, _, h1, _, hH, hsign, hring⟩ := boundary_chain I
  have hrat := stronglyRational_of I
  have hinit := initialGrades_of I
  have hchar := I.L_characters hmod h1 (projectiveVacuum_of I) hinit hrat
  have hcr := I.E_netCR hrat hinit
  have hcount := I.L_netCount hcr hH hsign hring I.C_discriminant
  have hrec := I.L_reconstruction hcr hrat hinit
  have hsu := I.L_stronglyUnitary hrec hcount hmod
  exact ⟨hrat, hinit, hsu, hcr, I.E_netCenter hcount, hchar.1,
    I.E_diagonal hcr hcount hrec hchar.1 hsu⟩

/-- **Theorem `claim:main`** follows from its inputs: complete unitarity,
`Rep(U) ≃ Z(𝓗₃)` as unitary ribbon categories, and the chosen `E₈` extension. -/
theorem thm_claim_main (I : Inputs N) :
    N.completelyUnitary ∧ N.repIsCenter ∧ N.e8Extension := by
  obtain ⟨hm1, _, hmod, hunt, hlag, _, _, hH, hsign, hring⟩ := boundary_chain I
  have hrat := stronglyRational_of I
  have hinit := initialGrades_of I
  have hcr := I.E_netCR hrat hinit
  have hcount := I.L_netCount hcr hH hsign hring I.C_discriminant
  have hrec := I.L_reconstruction hcr hrat hinit
  have hsu := I.L_stronglyUnitary hrec hcount hmod
  have hcu := I.E_tener hsu (I.L_annulus hrec hcr hinit)
  have hbu := I.L_boundaryUnitary hcu hlag
  have hcenter := I.E_moritaCenter (I.E_izumi hbu hm1 hunt) hlag hcu
  exact ⟨hcu, hcenter, I.E_e8Extension hcenter (projectiveVacuum_of I) hrat hcu⟩

#print axioms prop_mainproper
#print axioms thm_main_net
#print axioms thm_claim_main

end HaagerupIzumi.C8.ProofMap
