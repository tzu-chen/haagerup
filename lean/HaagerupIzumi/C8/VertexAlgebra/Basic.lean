@[expose] public section

/-!
# Vertex algebras through their modes

This is the shared interface for the vertex-algebra part of the c=8
formalization (Appendices B–F of `c8_expanded_20260929/haagerup_c8_expanded.tex`).

A vertex algebra is presented by its modes `a_(n) b = V.mode n a b`, `n : ℤ`.
The fields below are the standard consequences of the Borcherds (Jacobi)
identity and the vacuum axioms that the manuscript uses: the commutator
formula, the iterate (associativity) formula, skew symmetry, and the
translation identities, together with an `ℕ`-grading of CFT type in which a
mode `a_(n)` changes weight by `wt a - n - 1`.  Every field is a theorem of
vertex-algebra theory (e.g. Kac, *Vertex algebras for beginners*, §§1.3, 4.8;
Frenkel–Ben-Zvi §3; De Sole–Kac §1–2); the lattice VOA `V_{E_6 ⊕ A_2}` of the
construction satisfies all of them.  Nothing here is specific to the
central-charge-eight model.

The infinite sums `∑_{t ≥ 0}` of the textbook formulas are written over
explicit `Finset.range` bounds beyond which every summand vanishes by the
grading (`mode_trunc`).  The formulas are stated for homogeneous inputs;
linearity extends them.

Integer binomial coefficients `binom m t` for `m : ℤ` are `Ring.choose m t`.
-/

namespace HaagerupIzumi.C8

open scoped BigOperators

/-- The integer binomial coefficient `(m choose t)` for `m : ℤ`, as an element of `k`. -/
def zbinom (k : Type*) [Field k] (m : ℤ) (t : ℕ) : k := ((Ring.choose m t : ℤ) : k)

/-- An `ℕ`-graded vertex algebra of CFT type over a field `k`, presented by its modes.
`mode n a b` is `a_(n) b`; `T` is the translation operator `L(-1)`. -/
structure VertexAlgebra (k : Type*) [Field k] (V : Type*) [AddCommGroup V] [Module k V] where
  /-- `mode n a b = a_(n) b`. -/
  mode : ℤ → V →ₗ[k] V →ₗ[k] V
  /-- The vacuum vector. -/
  vac : V
  /-- Translation `T = L(-1)`. -/
  T : V →ₗ[k] V
  /-- The conformal-weight grading. -/
  grade : ℕ → Submodule k V
  grade_internal : DirectSum.IsInternal grade
  /-- CFT type: `V_0 = k·1`. -/
  grade_zero : grade 0 = k ∙ vac
  /-- `a_(n)` changes weight by `wt a - n - 1`. -/
  mode_grade : ∀ {i j : ℕ} {a b : V} (n : ℤ), a ∈ grade i → b ∈ grade j →
    n + 1 ≤ (i : ℤ) + j → mode n a b ∈ grade ((i : ℤ) + j - n - 1).toNat
  /-- Products of negative weight vanish. -/
  mode_trunc : ∀ {i j : ℕ} {a b : V} (n : ℤ), a ∈ grade i → b ∈ grade j →
    (i : ℤ) + j ≤ n → mode n a b = 0
  T_grade : ∀ {i : ℕ} {a : V}, a ∈ grade i → T a ∈ grade (i + 1)
  /-- `Y(1,z) = id`. -/
  vac_mode : ∀ (n : ℤ) (b : V), mode n vac b = if n = -1 then b else 0
  /-- Creation: `a_(n) 1 = 0` for `n ≥ 0`. -/
  mode_vac_nonneg : ∀ (n : ℤ) (a : V), 0 ≤ n → mode n a vac = 0
  /-- Creation: `a_(-1) 1 = a`. -/
  mode_vac_neg_one : ∀ a : V, mode (-1) a vac = a
  /-- `T a = a_(-2) 1`. -/
  T_eq : ∀ a : V, T a = mode (-2) a vac
  /-- `(T a)_(n) = -n a_(n-1)`. -/
  mode_T : ∀ (n : ℤ) (a b : V), mode n (T a) b = -((n : k) • mode (n - 1) a b)
  /-- `T` is a derivation of every product: `[T, a_(n)] = (T a)_(n)`. -/
  T_mode : ∀ (n : ℤ) (a b : V), T (mode n a b) = mode n (T a) b + mode n a (T b)
  /-- Commutator formula `[a_(m), b_(n)] = ∑_{t ≥ 0} (m choose t) (a_(t) b)_(m+n-t)`. -/
  commutator : ∀ {i j : ℕ} {a b : V}, a ∈ grade i → b ∈ grade j → ∀ (m n : ℤ) (c : V),
    mode m a (mode n b c) - mode n b (mode m a c) =
      ∑ t ∈ Finset.range (i + j), zbinom k m t • mode (m + n - t) (mode t a b) c
  /-- Iterate (associativity) formula
  `(a_(m) b)_(n) c = ∑_{t ≥ 0} (-1)^t (m choose t)
     (a_(m-t) b_(n+t) c - (-1)^m b_(m+n-t) a_(t) c)`. -/
  iterate : ∀ {i j l : ℕ} {a b c : V}, a ∈ grade i → b ∈ grade j → c ∈ grade l →
    ∀ m n : ℤ,
    mode n (mode m a b) c =
      ∑ t ∈ Finset.range (i + j + l + n.natAbs),
        ((-1 : k) ^ t * zbinom k m t) •
          (mode (m - t) a (mode (n + t) b c) - (-1 : k) ^ m • mode (m + n - t) b (mode t a c))
  /-- Skew symmetry `b_(n) a = ∑_{t ≥ 0} (-1)^(n+t+1) T^(t)/t! (a_(n+t) b)`. -/
  skew : ∀ {i j : ℕ} {a b : V}, a ∈ grade i → b ∈ grade j → ∀ n : ℤ,
    mode n b a =
      ∑ t ∈ Finset.range (i + j + n.natAbs),
        ((-1 : k) ^ (n + t + 1) * ((t.factorial : k))⁻¹) • (T ^ t) (mode (n + t) a b)

namespace VertexAlgebra

variable {k : Type*} [Field k] {V : Type*} [AddCommGroup V] [Module k V]
variable (A : VertexAlgebra k V)

/-- A vertex subalgebra: a subspace containing the vacuum and closed under all modes. -/
def IsSubalgebra (W : Submodule k V) : Prop :=
  A.vac ∈ W ∧ ∀ (n : ℤ), ∀ a ∈ W, ∀ b ∈ W, A.mode n a b ∈ W

/-- The vertex subalgebra generated by a set `S`. -/
def generated (S : Set V) : Submodule k V :=
  sInf {W : Submodule k V | A.IsSubalgebra W ∧ S ⊆ W}

/-- The differential normal span `𝒩(S)` (Definition `def:normal-span`): the smallest
subspace containing the vacuum and `S`, closed under translation and under
`(-1)`-products of its own elements (all parenthesizations). -/
def normalSpan (S : Set V) : Submodule k V :=
  sInf {W : Submodule k V | A.vac ∈ W ∧ S ⊆ W ∧ (∀ x ∈ W, A.T x ∈ W) ∧
    ∀ x ∈ W, ∀ y ∈ W, A.mode (-1) x y ∈ W}

/-- `S` strongly generates `W` if `W` is the normal span of `S`. -/
def StronglyGenerates (S : Set V) (W : Submodule k V) : Prop := A.normalSpan S = W

theorem vac_mem_normalSpan (S : Set V) : A.vac ∈ A.normalSpan S :=
  Submodule.mem_sInf.2 fun _ hW => hW.1

theorem subset_normalSpan (S : Set V) : S ⊆ A.normalSpan S :=
  fun _ hx => Submodule.mem_sInf.2 fun _ hW => hW.2.1 hx

theorem T_mem_normalSpan {S : Set V} {x : V} (hx : x ∈ A.normalSpan S) :
    A.T x ∈ A.normalSpan S :=
  Submodule.mem_sInf.2 fun _ hW => hW.2.2.1 _ (Submodule.mem_sInf.1 hx _ hW)

theorem prod_mem_normalSpan {S : Set V} {x y : V} (hx : x ∈ A.normalSpan S)
    (hy : y ∈ A.normalSpan S) : A.mode (-1) x y ∈ A.normalSpan S :=
  Submodule.mem_sInf.2 fun _ hW =>
    hW.2.2.2 _ (Submodule.mem_sInf.1 hx _ hW) _ (Submodule.mem_sInf.1 hy _ hW)

/-- Minimality of the normal span. -/
theorem normalSpan_le {S : Set V} {W : Submodule k V} (hvac : A.vac ∈ W) (hS : S ⊆ W)
    (hT : ∀ x ∈ W, A.T x ∈ W) (hprod : ∀ x ∈ W, ∀ y ∈ W, A.mode (-1) x y ∈ W) :
    A.normalSpan S ≤ W :=
  sInf_le ⟨hvac, hS, hT, hprod⟩

theorem generated_le {S : Set V} {W : Submodule k V} (hW : A.IsSubalgebra W)
    (hS : S ⊆ W) : A.generated S ≤ W :=
  sInf_le ⟨hW, hS⟩

end VertexAlgebra

/-- A vertex operator algebra: a vertex algebra with a conformal vector `ω` of weight two
whose modes `L(n) = ω_(n+1)` give the grading (`L(0)`) and translation (`L(-1)`).
Only these two properties of `ω` are recorded; further Virasoro relations are added as
explicit hypotheses where a proof needs them. -/
structure VertexOperatorAlgebra (k : Type*) [Field k] (V : Type*) [AddCommGroup V]
    [Module k V] extends VertexAlgebra k V where
  ω : V
  ω_mem : ω ∈ grade 2
  /-- `L(0) = ω_(1)` acts on `V_d` by `d`. -/
  L0 : ∀ {d : ℕ} {a : V}, a ∈ grade d → mode 1 ω a = (d : k) • a
  /-- `L(-1) = ω_(0) = T`. -/
  Lm1 : ∀ a : V, mode 0 ω a = T a

end HaagerupIzumi.C8
