module

public import HaagerupIzumi.C8.VertexAlgebra.Weak
public import HaagerupIzumi.C8.SimpleQuotient

@[expose] public section

/-!
# The diagonal subalgebra and uniqueness of the finitely presented algebra

The uniqueness half of Proposition `prop:pf13-finite-reconstruction` (lines 2732–2827 of
`c8_expanded_20260929/haagerup_c8_expanded.tex`, especially 2815–2826): "take the vertex
subalgebra `D ⊂ V × V'` generated by the diagonal pairs of the named fields.  Common polynomial
OPE closure and filtered Wick induction show that `D` is their differential normal span.  Every
generator has positive weight, so `D_0 = ℂ(1, 1)` … The coordinate projections are surjective …
The kernels coincide, which gives the asserted isomorphism."

For vertex algebras `A` on `V` and `A'` on `V'` (shared interface `VertexAlgebra`, field of
characteristic zero):

* `prodWeak A A'`: `V × V'` with componentwise modes, vacuum `(1, 1)`, translation `T × T'`
  and grading `V_d × V'_d`.  It is not of CFT type (its weight-zero space is two-dimensional),
  so it is a `WeakVertexAlgebra` (all interface fields except `grade_zero`).
* `diagonalSpan A A' g g'`: for generators `g i ∈ V_{w i}`, `g' i ∈ V'_{w i}` of positive
  weights, the differential normal span `D` of the diagonal pairs `(g i, g' i)`.
* `diagonalSpan_isClosed`: if every singular product of diagonal generators lies in `D`
  (hypothesis `hcert`: for **all** ordered pairs of generators, the full singular products agree
  as the same normal polynomials), then `D` is closed under all modes (filtered Wick induction in
  `V × V'`, `WeakVertexAlgebra.normalSpan_isClosed`).  For Proposition
  `prop:pf13-finite-reconstruction`, `hcert` is **not** a certificate input: it is the conclusion
  of the first half of the proof (recovery of all generator rows, lines 2742–2813).  Only the
  `a`-rows `a_n a`, `a_n b`, `a_n d` are certificate inputs there; see `PF13.lean` and
  `PF13Product.lean` for what of the recovery is formalized.
* `diagonalVA`: `D` is a vertex algebra of CFT type (`D_0 = k·(1, 1)`, grading inherited,
  internal direct sum).
* `proj₁_isGradedHom`, `proj₂_isGradedHom`: the coordinate projections are grading-preserving
  homomorphisms; `proj₁_surjective`, `proj₂_surjective`: they are surjective when the `g i`
  (resp. `g' i`) generate.
* `diagonal_reconstruction`: if moreover `A` and `A'` are simple, there is a linear isomorphism
  `φ : V ≃ V'` with `φ (g i) = g' i`, `φ 1 = 1'`, preserving all modes
  (via `SimpleQuotient.simple_quotient_unique`).

The only hypotheses are `hcert` (closure of all generator pairs, which for PF13 is the output of
the row recovery, not a certificate input), simplicity, and generation; no freeness or
independence of normal monomials is used.
-/

namespace HaagerupIzumi.C8

namespace Diagonal

open scoped BigOperators

variable {k : Type*} [Field k] {V V' : Type*} [AddCommGroup V] [Module k V]
  [AddCommGroup V'] [Module k V']
variable (A : VertexAlgebra k V) (A' : VertexAlgebra k V')

/-! ### The product `V × V'` -/

/-- Componentwise modes on `V × V'`. -/
def prodMode (n : ℤ) : V × V' →ₗ[k] V × V' →ₗ[k] V × V' :=
  LinearMap.mk₂ k (fun p q => (A.mode n p.1 q.1, A'.mode n p.2 q.2))
    (fun p₁ p₂ q => by ext <;> simp)
    (fun c p q => by ext <;> simp)
    (fun p q₁ q₂ => by ext <;> simp)
    (fun c p q => by ext <;> simp)

theorem prodMode_apply (n : ℤ) (p q : V × V') :
    prodMode A A' n p q = (A.mode n p.1 q.1, A'.mode n p.2 q.2) := rfl

theorem prodMap_pow_apply (f : V →ₗ[k] V) (f' : V' →ₗ[k] V') (t : ℕ) (p : V × V') :
    ((f.prodMap f') ^ t) p = ((f ^ t) p.1, (f' ^ t) p.2) := by
  induction t generalizing p with
  | zero => simp
  | succ t ih => simp only [pow_succ, Module.End.mul_apply, ih, LinearMap.prodMap_apply]

theorem vac_mem_grade_zero : A.vac ∈ A.grade 0 := by
  rw [A.grade_zero]
  exact Submodule.mem_span_singleton_self _

theorem prod_grade_internal :
    DirectSum.IsInternal (fun d => (A.grade d).prod (A'.grade d)) := by
  apply DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
  · intro d
    rw [Submodule.disjoint_def]
    intro x hx hx'
    have hle : (⨆ (e : ℕ) (_ : e ≠ d), (A.grade e).prod (A'.grade e)) ≤
        (⨆ (e : ℕ) (_ : e ≠ d), A.grade e).prod (⨆ (e : ℕ) (_ : e ≠ d), A'.grade e) :=
      iSup₂_le fun e he =>
        Submodule.prod_mono (le_iSup₂_of_le e he le_rfl) (le_iSup₂_of_le e he le_rfl)
    have h1 : x.1 ∈ A.grade d ∧ x.2 ∈ A'.grade d := Submodule.mem_prod.1 hx
    have h2 := Submodule.mem_prod.1 (hle hx')
    exact Prod.ext
      (Submodule.disjoint_def.1 (A.grade_internal.submodule_iSupIndep d) _ h1.1 h2.1)
      (Submodule.disjoint_def.1 (A'.grade_internal.submodule_iSupIndep d) _ h1.2 h2.2)
  · rw [eq_top_iff]
    rintro ⟨x, x'⟩ -
    have hx : x ∈ ⨆ d, A.grade d := by
      rw [A.grade_internal.submodule_iSup_eq_top]
      exact Submodule.mem_top
    have hx' : x' ∈ ⨆ d, A'.grade d := by
      rw [A'.grade_internal.submodule_iSup_eq_top]
      exact Submodule.mem_top
    have h1 : Submodule.map (LinearMap.inl k V V') (⨆ d, A.grade d) ≤
        ⨆ d, (A.grade d).prod (A'.grade d) := by
      rw [Submodule.map_iSup]
      refine iSup_mono fun d => ?_
      rintro _ ⟨y, hy, rfl⟩
      simpa using hy
    have h2 : Submodule.map (LinearMap.inr k V V') (⨆ d, A'.grade d) ≤
        ⨆ d, (A.grade d).prod (A'.grade d) := by
      rw [Submodule.map_iSup]
      refine iSup_mono fun d => ?_
      rintro _ ⟨y, hy, rfl⟩
      simpa using hy
    have := Submodule.add_mem _ (h1 (Submodule.mem_map.2 ⟨x, hx, rfl⟩))
      (h2 (Submodule.mem_map.2 ⟨x', hx', rfl⟩))
    simpa using this

/-- `V × V'` as a weak vertex algebra (all interface fields except the CFT-type axiom). -/
noncomputable def prodWeak : WeakVertexAlgebra k (V × V') where
  mode := prodMode A A'
  vac := (A.vac, A'.vac)
  T := A.T.prodMap A'.T
  grade := fun d => (A.grade d).prod (A'.grade d)
  grade_internal := prod_grade_internal A A'
  vac_mem_grade_zero := Submodule.mem_prod.2 ⟨vac_mem_grade_zero A, vac_mem_grade_zero A'⟩
  mode_grade := fun n ha hb h => Submodule.mem_prod.2
    ⟨A.mode_grade n (Submodule.mem_prod.1 ha).1 (Submodule.mem_prod.1 hb).1 h,
      A'.mode_grade n (Submodule.mem_prod.1 ha).2 (Submodule.mem_prod.1 hb).2 h⟩
  mode_trunc := fun n ha hb h => Prod.ext
    (A.mode_trunc n (Submodule.mem_prod.1 ha).1 (Submodule.mem_prod.1 hb).1 h)
    (A'.mode_trunc n (Submodule.mem_prod.1 ha).2 (Submodule.mem_prod.1 hb).2 h)
  T_grade := fun ha => Submodule.mem_prod.2
    ⟨A.T_grade (Submodule.mem_prod.1 ha).1, A'.T_grade (Submodule.mem_prod.1 ha).2⟩
  vac_mode := fun n b => by
    by_cases hn : n = -1
    · rw [if_pos hn]
      exact Prod.ext (by simp [prodMode_apply, A.vac_mode, hn])
        (by simp [prodMode_apply, A'.vac_mode, hn])
    · rw [if_neg hn]
      exact Prod.ext (by simp [prodMode_apply, A.vac_mode, hn])
        (by simp [prodMode_apply, A'.vac_mode, hn])
  mode_vac_nonneg := fun n a h =>
    Prod.ext (A.mode_vac_nonneg n a.1 h) (A'.mode_vac_nonneg n a.2 h)
  mode_vac_neg_one := fun a => Prod.ext (A.mode_vac_neg_one a.1) (A'.mode_vac_neg_one a.2)
  T_eq := fun a => Prod.ext (A.T_eq a.1) (A'.T_eq a.2)
  mode_T := fun n a b => Prod.ext (A.mode_T n a.1 b.1) (A'.mode_T n a.2 b.2)
  T_mode := fun n a b => Prod.ext (A.T_mode n a.1 b.1) (A'.T_mode n a.2 b.2)
  commutator := fun {i j a b} ha hb m n c => by
    obtain ⟨ha1, ha2⟩ := Submodule.mem_prod.1 ha
    obtain ⟨hb1, hb2⟩ := Submodule.mem_prod.1 hb
    refine Prod.ext ?_ ?_
    · simp only [prodMode_apply, Prod.fst_sub, Prod.fst_sum, Prod.smul_fst]
      exact A.commutator ha1 hb1 m n c.1
    · simp only [prodMode_apply, Prod.snd_sub, Prod.snd_sum, Prod.smul_snd]
      exact A'.commutator ha2 hb2 m n c.2
  iterate := fun {i j l a b c} ha hb hc m n => by
    obtain ⟨ha1, ha2⟩ := Submodule.mem_prod.1 ha
    obtain ⟨hb1, hb2⟩ := Submodule.mem_prod.1 hb
    obtain ⟨hc1, hc2⟩ := Submodule.mem_prod.1 hc
    refine Prod.ext ?_ ?_
    · simp only [prodMode_apply, Prod.fst_sub, Prod.fst_sum, Prod.smul_fst]
      exact A.iterate ha1 hb1 hc1 m n
    · simp only [prodMode_apply, Prod.snd_sub, Prod.snd_sum, Prod.smul_snd]
      exact A'.iterate ha2 hb2 hc2 m n
  skew := fun {i j a b} ha hb n => by
    obtain ⟨ha1, ha2⟩ := Submodule.mem_prod.1 ha
    obtain ⟨hb1, hb2⟩ := Submodule.mem_prod.1 hb
    refine Prod.ext ?_ ?_
    · simp only [prodMode_apply, Prod.fst_sum, Prod.smul_fst, prodMap_pow_apply]
      exact A.skew ha1 hb1 n
    · simp only [prodMode_apply, Prod.snd_sum, Prod.smul_snd, prodMap_pow_apply]
      exact A'.skew ha2 hb2 n

theorem prodWeak_mode (n : ℤ) (p q : V × V') :
    (prodWeak A A').mode n p q = (A.mode n p.1 q.1, A'.mode n p.2 q.2) := rfl

theorem prodWeak_vac : (prodWeak A A').vac = (A.vac, A'.vac) := rfl

theorem mem_prodWeak_grade {d : ℕ} {p : V × V'} :
    p ∈ (prodWeak A A').grade d ↔ p.1 ∈ A.grade d ∧ p.2 ∈ A'.grade d :=
  Submodule.mem_prod

/-! ### The diagonal normal span -/

variable {ι : Type*} (g : ι → V) (g' : ι → V')

/-- The diagonal generators `(g i, g' i)`. -/
def diagGens : Set (V × V') := Set.range fun i => (g i, g' i)

/-- `D`: the differential normal span of the diagonal generators in `V × V'`. -/
noncomputable def diagonalSpan : Submodule k (V × V') :=
  (prodWeak A A').normalSpan (diagGens g g')

theorem diag_mem_diagonalSpan (i : ι) : (g i, g' i) ∈ diagonalSpan A A' g g' :=
  (prodWeak A A').subset_normalSpan _ ⟨i, rfl⟩

section Reconstruction

variable {A A' g g'} {w : ι → ℕ}
variable (hw : ∀ i, 0 < w i) (hg : ∀ i, g i ∈ A.grade (w i)) (hg' : ∀ i, g' i ∈ A'.grade (w i))

include hg hg' in
theorem diagGens_homogeneous : ∀ s ∈ diagGens g g', ∃ d, s ∈ (prodWeak A A').grade d := by
  rintro _ ⟨i, rfl⟩
  exact ⟨w i, (mem_prodWeak_grade A A').2 ⟨hg i, hg' i⟩⟩

include hw hg hg' in
theorem diagGens_weight_zero :
    ∀ s ∈ diagGens g g', s ∈ (prodWeak A A').grade 0 → s = 0 := by
  rintro _ ⟨i, rfl⟩ h0
  obtain ⟨h1, h2⟩ := (mem_prodWeak_grade A A').1 h0
  exact Prod.ext (A.eq_zero_of_mem_grade_of_ne h1 (hg i) (hw i).ne)
    (A'.eq_zero_of_mem_grade_of_ne h2 (hg' i) (hw i).ne)

include hw hg hg' in
/-- `D ∩ (V_0 × V'_0) = k·(1, 1)`. -/
theorem diagonalSpan_inf_grade_zero :
    diagonalSpan A A' g g' ⊓ (prodWeak A A').grade 0 ≤ k ∙ (prodWeak A A').vac :=
  (prodWeak A A').normalSpan_inf_grade_zero_le (diagGens_homogeneous hg hg')
    (diagGens_weight_zero hw hg hg')

variable [CharZero k]
variable (hcert : ∀ i j (n : ℕ),
  ((A.mode n (g i) (g j), A'.mode n (g' i) (g' j)) : V × V') ∈ diagonalSpan A A' g g')

include hw hg hg' hcert in
/-- **Closure of `D`.**  If all singular products of diagonal generators lie in `D`, then `D` is
closed under every mode of `V × V'`. -/
theorem diagonalSpan_isClosed (n : ℤ) :
    ∀ x ∈ diagonalSpan A A' g g', ∀ y ∈ diagonalSpan A A' g g',
      (prodWeak A A').mode n x y ∈ diagonalSpan A A' g g' := by
  refine (prodWeak A A').normalSpan_isClosed (diagGens_homogeneous hg hg')
    (diagGens_weight_zero hw hg hg') ?_ n
  rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ n
  exact hcert i j n

/-- **`D` is a vertex algebra of CFT type**, with the grading inherited from `V × V'`. -/
noncomputable def diagonalVA : VertexAlgebra k (diagonalSpan A A' g g') :=
  (prodWeak A A').subVertexAlgebra (diagonalSpan_isClosed hw hg hg' hcert)
    ((prodWeak A A').vac_mem_normalSpan _) (fun _ hx => (prodWeak A A').T_mem_normalSpan hx)
    ((prodWeak A A').normalSpan_le_iSup_inf_grade (diagGens_homogeneous hg hg'))
    (diagonalSpan_inf_grade_zero hw hg hg')

/-- The first coordinate projection `D → V`. -/
noncomputable def proj₁ : diagonalSpan A A' g g' →ₗ[k] V :=
  (LinearMap.fst k V V').comp (diagonalSpan A A' g g').subtype

/-- The second coordinate projection `D → V'`. -/
noncomputable def proj₂ : diagonalSpan A A' g g' →ₗ[k] V' :=
  (LinearMap.snd k V V').comp (diagonalSpan A A' g g').subtype

theorem proj₁_isGradedHom :
    SimpleQuotient.IsGradedHom (diagonalVA hw hg hg' hcert) A proj₁ where
  map_vac := rfl
  map_mode := fun _ _ _ => rfl
  map_grade := fun d x hx => by
    have hx' : (x : V × V') ∈ (prodWeak A A').grade d := hx
    exact ((mem_prodWeak_grade A A').1 hx').1

theorem proj₂_isGradedHom :
    SimpleQuotient.IsGradedHom (diagonalVA hw hg hg' hcert) A' proj₂ where
  map_vac := rfl
  map_mode := fun _ _ _ => rfl
  map_grade := fun d x hx => by
    have hx' : (x : V × V') ∈ (prodWeak A A').grade d := hx
    exact ((mem_prodWeak_grade A A').1 hx').2

include hw hg hg' hcert in
/-- The first projection is surjective when the `g i` generate `V`. -/
theorem proj₁_surjective (gen : A.generated (Set.range g) = ⊤) :
    Function.Surjective (proj₁ : diagonalSpan A A' g g' →ₗ[k] V) := by
  have hπ := proj₁_isGradedHom hw hg hg' hcert
  have hsub : A.IsSubalgebra (LinearMap.range (proj₁ : diagonalSpan A A' g g' →ₗ[k] V)) := by
    refine ⟨LinearMap.mem_range.2 ⟨_, hπ.map_vac⟩, fun n x hx y hy => ?_⟩
    obtain ⟨a, rfl⟩ := LinearMap.mem_range.1 hx
    obtain ⟨b, rfl⟩ := LinearMap.mem_range.1 hy
    exact LinearMap.mem_range.2 ⟨_, hπ.map_mode n a b⟩
  have hgen : Set.range g ⊆ LinearMap.range (proj₁ : diagonalSpan A A' g g' →ₗ[k] V) := by
    rintro _ ⟨i, rfl⟩
    exact LinearMap.mem_range.2 ⟨⟨(g i, g' i), diag_mem_diagonalSpan A A' g g' i⟩, rfl⟩
  have htop : LinearMap.range (proj₁ : diagonalSpan A A' g g' →ₗ[k] V) = ⊤ := by
    rw [eq_top_iff, ← gen]
    exact A.generated_le hsub hgen
  exact LinearMap.range_eq_top.1 htop

include hw hg hg' hcert in
/-- The second projection is surjective when the `g' i` generate `V'`. -/
theorem proj₂_surjective (gen' : A'.generated (Set.range g') = ⊤) :
    Function.Surjective (proj₂ : diagonalSpan A A' g g' →ₗ[k] V') := by
  have hπ := proj₂_isGradedHom hw hg hg' hcert
  have hsub : A'.IsSubalgebra (LinearMap.range (proj₂ : diagonalSpan A A' g g' →ₗ[k] V')) := by
    refine ⟨LinearMap.mem_range.2 ⟨_, hπ.map_vac⟩, fun n x hx y hy => ?_⟩
    obtain ⟨a, rfl⟩ := LinearMap.mem_range.1 hx
    obtain ⟨b, rfl⟩ := LinearMap.mem_range.1 hy
    exact LinearMap.mem_range.2 ⟨_, hπ.map_mode n a b⟩
  have hgen : Set.range g' ⊆ LinearMap.range (proj₂ : diagonalSpan A A' g g' →ₗ[k] V') := by
    rintro _ ⟨i, rfl⟩
    exact LinearMap.mem_range.2 ⟨⟨(g i, g' i), diag_mem_diagonalSpan A A' g g' i⟩, rfl⟩
  have htop : LinearMap.range (proj₂ : diagonalSpan A A' g g' →ₗ[k] V') = ⊤ := by
    rw [eq_top_iff, ← gen']
    exact A'.generated_le hsub hgen
  exact LinearMap.range_eq_top.1 htop

include hw hg hg' hcert in
/-- **Uniqueness half of Proposition `prop:pf13-finite-reconstruction`.**  Let `A`, `A'` be
simple vertex algebras (shared interface, characteristic zero) generated by `g i` and `g' i`,
with `g i ∈ V_{w i}`, `g' i ∈ V'_{w i}` of positive weights.  If every singular product
`(g i_(n) g j, g' i_(n) g' j)`, `n ≥ 0`, lies in the differential normal span `D` of the
diagonal pairs (the full singular products agree as the same normal polynomials), then there is
a linear isomorphism `φ : V ≃ V'` with `φ (g i) = g' i` and `φ 1 = 1'` that preserves all
modes.  (For PF13 the hypothesis `hcert` covers **all** ordered generator pairs and is the
conclusion of the row recovery, not a certificate input.) -/
theorem diagonal_reconstruction (simple : SimpleQuotient.IsSimple A)
    (simple' : SimpleQuotient.IsSimple A') (gen : A.generated (Set.range g) = ⊤)
    (gen' : A'.generated (Set.range g') = ⊤) :
    ∃ φ : V ≃ₗ[k] V', (∀ i, φ (g i) = g' i) ∧ φ A.vac = A'.vac ∧
      ∀ (n : ℤ) (a b : V), φ (A.mode n a b) = A'.mode n (φ a) (φ b) := by
  obtain ⟨φ, hφ, hvac, hmode⟩ := SimpleQuotient.simple_quotient_unique
    (diagonalVA hw hg hg' hcert) A A' (proj₁_isGradedHom hw hg hg' hcert)
    (proj₂_isGradedHom hw hg hg' hcert) (proj₁_surjective hw hg hg' hcert gen)
    (proj₂_surjective hw hg hg' hcert gen') simple simple'
  refine ⟨φ, fun i => ?_, hvac, hmode⟩
  exact hφ ⟨(g i, g' i), diag_mem_diagonalSpan A A' g g' i⟩

end Reconstruction

end Diagonal

end HaagerupIzumi.C8

