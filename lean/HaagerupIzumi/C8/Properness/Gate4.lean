module

public import HaagerupIzumi.C8.Properness.FullNormal
public import HaagerupIzumi.CFT.FiniteClosure

@[expose] public section

/-! # Gate 4: `(S₂)₀S₃ ⊂ W₄`

Formalizes Section `sec:gate4` of `c8_expanded_20260929/haagerup_c8_expanded.tex`
(lines 2268–2342):

* Lemma `lem:raising` (raising saturation), via `HaagerupIzumi.CFT.nilpotent_raising_saturation`
  applied on `S₃` to the kernel of `p ↦ [a₀p] ∈ B₄/W₄`, which is stable under the raising
  currents because `a` is joint-highest and `W₄` is current-stable ("current covariance").
* Lemma `lem:singlet` (recovery from the joint-singlet projection `Π`, eq. `eq:projector`),
  via `HaagerupIzumi.CFT.projected_residual_recovery`.  Only `E t ∈ W₄` and the stability
  of `W₄, N₄` under current zero modes are used: every factor `1 - c F E` is the identity
  modulo `W₄` on `t + W₄`.
* Current covariance for the charged descendants, the affine part `TK + K₋₁K` of `S₂`
  (iterate formula), and `ω_B` (`ω₀ = T`); the second neutral field is
  `ω_B − ω_{K_L} − ω_{K_R} − e` and is covered by linearity.

The certificate inputs are collected in `Gate4Certificate` (records listed there).  The
nilpotence of raising words of length 25 on `S₃` (Lemma `lem:current-bounds`, lines
2289–2295) is a separate explicit hypothesis `hnil`.
-/

namespace HaagerupIzumi.C8

open scoped BigOperators

variable {k : Type*} [Field k] {V : Type*} [AddCommGroup V] [Module k V]

namespace VertexAlgebra

variable (A : VertexAlgebra k V)

/-- The space of vectors `a` with `a_(n) Y ⊂ Z`. -/
def modeSpace (n : ℤ) (Y Z : Submodule k V) : Submodule k V where
  carrier := {a | ∀ y ∈ Y, A.mode n a y ∈ Z}
  add_mem' := by
    intro a b ha hb y hy
    rw [map_add, LinearMap.add_apply]
    exact Z.add_mem (ha y hy) (hb y hy)
  zero_mem' := by
    intro y _
    rw [map_zero, LinearMap.zero_apply]
    exact Z.zero_mem
  smul_mem' := by
    intro c a ha y hy
    rw [map_smul, LinearMap.smul_apply]
    exact Z.smul_mem c (ha y hy)

theorem mem_modeSpace {n : ℤ} {Y Z : Submodule k V} {a : V} :
    a ∈ A.modeSpace n Y Z ↔ ∀ y ∈ Y, A.mode n a y ∈ Z := Iff.rfl

end VertexAlgebra

/-- The factors of the joint-singlet projector `Π` of eq. `eq:projector`:
`1 - 4 F_L E_L / (j (j+2))` for `j ∈ {2,4}` (`true` = left) and
`1 - 4 F_R E_R / (j (j+2))` for `j ∈ {2,4,…,24}` (`false` = right).  The head of the list is
the outermost factor; the order is that of the exact replay
(`hi_cft_20260923_c8two_h4_singlet_common.py`, `factors()`/`project`): the left factors
`j = 2, 4` act first, then the right factors `j = 2, …, 24`. -/
def singletFactors (k : Type*) [Field k] : List (Bool × k) :=
  (((List.range 12).reverse.map (fun i : ℕ => 2 * (i + 1))).map
      (fun j : ℕ => (false, (4 : k) / ((j : k) * ((j : k) + 2))))) ++
    ([4, 2] : List ℕ).map (fun j : ℕ => (true, (4 : k) / ((j : k) * ((j : k) + 2))))

namespace ClosureData

variable {A : VertexOperatorAlgebra k V} (D : ClosureData A)

/-- `F E` for the left (`true`) or right (`false`) current pair (raising acts first). -/
def FE (side : Bool) : V →ₗ[k] V :=
  (A.mode 0 (if side then D.fL else D.fR)) ∘ₗ (A.mode 0 (if side then D.eL else D.eR))

/-- The product of factors `1 - c F E`, the head of the list being outermost. -/
def projector : List (Bool × k) → V →ₗ[k] V
  | [] => LinearMap.id
  | p :: l => (LinearMap.id - p.2 • D.FE p.1) ∘ₗ projector l

/-- The joint-singlet projector `Π` of eq. `eq:projector`. -/
def singletProjector : V →ₗ[k] V := D.projector (singletFactors k)

/-- The current module generated by a set: the smallest subspace containing it and stable
under all current zero modes. -/
def currentSpan (H : Set V) : Submodule k V :=
  sInf {M : Submodule k V | H ⊆ M ∧ ∀ x ∈ D.K, ∀ v ∈ M, A.mode 0 x v ∈ M}

theorem currentSpan_le {H : Set V} {M : Submodule k V} (hH : H ⊆ M)
    (hM : ∀ x ∈ D.K, ∀ v ∈ M, A.mode 0 x v ∈ M) : D.currentSpan H ≤ M :=
  sInf_le ⟨hH, hM⟩

theorem subset_currentSpan (H : Set V) : H ⊆ D.currentSpan H :=
  fun _ hx => Submodule.mem_sInf.mpr fun _ hM => hM.1 hx

theorem currentSpan_stable (H : Set V) {x : V} (hx : x ∈ D.K) {v : V}
    (hv : v ∈ D.currentSpan H) : A.mode 0 x v ∈ D.currentSpan H :=
  Submodule.mem_sInf.mpr fun _ hM => hM.2 x hx _ (Submodule.mem_sInf.mp hv _ hM)

end ClosureData

variable {A : VertexOperatorAlgebra k V}

/-- Certificate inputs of Gate 4.

* `highest`: the nine joint-highest primitive fields used for Gate 4 (the eight charged
  highest vectors and the retained neutral singlet `e`); `highest_eL`, `highest_eR`: they
  are joint highest (record `hi_cft_20260923_c8_exact_fields.json`).
* `seed a`: inputs `p ∈ S₃` whose outputs `a₀p` have completed exact identities
  `a₀p ∈ 𝒩₄(K + S₂ + S₃) + P₄` (`seed_identity`; the solver's columns are normal words): the 2,145 original seed identities and the 118 direct exact
  residual certificates (record `..._c8two_targeted_h4_trimmed_v2/summary.json`).
* `singletSeed a`: the twelve inputs whose outputs `t = a₀p` have weight `(0,0)`;
  `singlet_premise_L/R`: `E_L t, E_R t ∈ 𝒩₄ + P₄` (record
  `..._c8two_h4_singlet_premise_verified.json`, 24 raising conditions, using the twelve
  raised identities of `..._c8two_structure_h4_raised_exact/summary.json`);
  `projected_residual`: `Π t = Π n` with `n ∈ 𝒩₄` (record `..._c8two_h4_singlet_exact.json`,
  twelve full exact residuals with 21 selected normal columns).
* `raising_span`: `S₃ = E_L S₃ + E_R S₃ + span(seeds) + N₃` (record
  `..._c8two_structure_saturation.json`: 644 raising images of rank 294, completed by the
  seeds to rank 322 = dim S₃/N₃, for each of the nine fields).
* `S₂_decomp`: `S₂` is spanned by the current modules of the nine highest fields, the
  22 affine vacuum vectors `TK + K₋₁K` and `ω_B` (Certificate `cert:initial`; the second
  neutral field is `ω_B − ω_{A₁,₁} − ω_{A₁,₃₉} − e`, eq. `eq:two-coset-stresses`, with
  Sugawara vectors in `K₋₁K`). -/
structure Gate4Certificate (D : ClosureData A) where
  highest : Set V
  seed : V → Set V
  singletSeed : V → Set V
  highest_S₂ : highest ⊆ D.S₂
  highest_eL : ∀ a ∈ highest, A.mode 0 D.eL a = 0
  highest_eR : ∀ a ∈ highest, A.mode 0 D.eR a = 0
  seed_S₃ : ∀ a ∈ highest, seed a ⊆ D.S₃
  singletSeed_S₃ : ∀ a ∈ highest, singletSeed a ⊆ D.S₃
  seed_identity : ∀ a ∈ highest, ∀ p ∈ seed a, A.mode 0 a p ∈ D.fullN₄ ⊔ D.P₄
  singlet_premise_L : ∀ a ∈ highest, ∀ p ∈ singletSeed a,
    A.mode 0 D.eL (A.mode 0 a p) ∈ D.fullN₄ ⊔ D.P₄
  singlet_premise_R : ∀ a ∈ highest, ∀ p ∈ singletSeed a,
    A.mode 0 D.eR (A.mode 0 a p) ∈ D.fullN₄ ⊔ D.P₄
  projected_residual : ∀ a ∈ highest, ∀ p ∈ singletSeed a,
    ∃ n ∈ D.fullN₄, D.singletProjector (A.mode 0 a p) = D.singletProjector n
  raising_span : ∀ a ∈ highest, D.S₃ ≤ D.S₃.map (A.mode 0 D.eL) ⊔ D.S₃.map (A.mode 0 D.eR) ⊔
    Submodule.span k (seed a ∪ singletSeed a) ⊔ D.N₃
  S₂_decomp : D.S₂ ≤ D.currentSpan highest ⊔ D.K.map A.T ⊔ A.negProd D.K D.K ⊔ (k ∙ A.ω)

/-- Restricting the two raising operators to an invariant subspace commutes with forming
raising words. -/
theorem raisingWord_restrict (f g : V →ₗ[k] V) {p : Submodule k V} (hf : ∀ x ∈ p, f x ∈ p)
    (hg : ∀ x ∈ p, g x ∈ p) (w : List Bool) (v : p) :
    ((CFT.raisingWord (f.restrict hf) (g.restrict hg) w v : p) : V) =
      CFT.raisingWord f g w (v : V) := by
  induction w with
  | nil => rfl
  | cons b w ih =>
    cases b
    · change ((g.restrict hg) (CFT.raisingWord (f.restrict hf) (g.restrict hg) w v) : V) =
        g (CFT.raisingWord f g w v)
      rw [LinearMap.coe_restrict_apply, ih]
    · change ((f.restrict hf) (CFT.raisingWord (f.restrict hf) (g.restrict hg) w v) : V) =
        f (CFT.raisingWord f g w v)
      rw [LinearMap.coe_restrict_apply, ih]

namespace LowerCertificate

variable [CharZero k] {D : ClosureData A}

omit [CharZero k] in
theorem FE_mem {X : Submodule k V} (hX : ∀ x ∈ D.K, ∀ v ∈ X, A.mode 0 x v ∈ X)
    (side : Bool) {v : V} (hv : v ∈ X) : D.FE side v ∈ X := by
  cases side
  · show A.mode 0 D.fR (A.mode 0 D.eR v) ∈ X
    exact hX _ D.fR_mem _ (hX _ D.eR_mem _ hv)
  · show A.mode 0 D.fL (A.mode 0 D.eL v) ∈ X
    exact hX _ D.fL_mem _ (hX _ D.eL_mem _ hv)

omit [CharZero k] in
theorem projector_mem {X : Submodule k V} (hX : ∀ x ∈ D.K, ∀ v ∈ X, A.mode 0 x v ∈ X) :
    ∀ (l : List (Bool × k)) {v : V}, v ∈ X → D.projector l v ∈ X
  | [], _, hv => hv
  | p :: l, v, hv => by
      show ((LinearMap.id - p.2 • D.FE p.1 : V →ₗ[k] V) (D.projector l v)) ∈ X
      rw [LinearMap.sub_apply, LinearMap.id_apply, LinearMap.smul_apply]
      exact X.sub_mem (projector_mem hX l hv)
        (X.smul_mem _ (FE_mem hX p.1 (projector_mem hX l hv)))

omit [CharZero k] in
/-- The quotient step of Lemma `lem:singlet`: if both raising currents send `t` into a
current-stable `W`, every product of factors `1 - c F E` fixes `t` modulo `W`. -/
theorem projector_sub_mem {W : Submodule k V} (hW : ∀ x ∈ D.K, ∀ v ∈ W, A.mode 0 x v ∈ W)
    {t : V} (hLt : A.mode 0 D.eL t ∈ W) (hRt : A.mode 0 D.eR t ∈ W) :
    ∀ l : List (Bool × k), D.projector l t - t ∈ W
  | [] => by
      show LinearMap.id t - t ∈ W
      rw [LinearMap.id_apply, sub_self]
      exact W.zero_mem
  | (side, c) :: l => by
      have ih := projector_sub_mem hW hLt hRt l
      have hEx : A.mode 0 (if side then D.eL else D.eR) (D.projector l t) ∈ W := by
        have e : A.mode 0 (if side then D.eL else D.eR) (D.projector l t) =
            A.mode 0 (if side then D.eL else D.eR) t +
              A.mode 0 (if side then D.eL else D.eR) (D.projector l t - t) := by
          rw [map_sub]; abel
        rw [e]
        cases side
        · exact W.add_mem hRt (hW _ D.eR_mem _ ih)
        · exact W.add_mem hLt (hW _ D.eL_mem _ ih)
      have hFE : D.FE side (D.projector l t) ∈ W := by
        show A.mode 0 (if side then D.fL else D.fR)
          (A.mode 0 (if side then D.eL else D.eR) (D.projector l t)) ∈ W
        cases side
        · exact hW _ D.fR_mem _ hEx
        · exact hW _ D.fL_mem _ hEx
      show ((LinearMap.id - c • D.FE side : V →ₗ[k] V) (D.projector l t)) - t ∈ W
      rw [LinearMap.sub_apply, LinearMap.id_apply, LinearMap.smul_apply,
        show D.projector l t - c • D.FE side (D.projector l t) - t =
          (D.projector l t - t) - c • D.FE side (D.projector l t) by abel]
      exact W.sub_mem ih (W.smul_mem _ hFE)

variable (L : LowerCertificate D)
include L

/-- Lemma `lem:singlet` (recovery from a joint-singlet projection). -/
theorem singlet_recovery {t : V} (hLt : A.mode 0 D.eL t ∈ D.W₄)
    (hRt : A.mode 0 D.eR t ∈ D.W₄)
    (hres : ∃ n ∈ D.N₄, D.singletProjector t = D.singletProjector n) : t ∈ D.W₄ := by
  obtain ⟨n, hn, hPi⟩ := hres
  refine CFT.projected_residual_recovery D.W₄ D.singletProjector t ?_ ?_
  · have h := projector_sub_mem (fun x hx v hv => L.KW₄0 hx v hv) hLt hRt (singletFactors k)
    rw [← neg_sub]
    exact D.W₄.neg_mem h
  · rw [hPi]
    exact D.N₄_le_W₄ (projector_mem (fun x hx v hv => L.KN₄0 hx v hv) _ hn)

/-- Lemma `lem:raising` (raising saturation) for one joint-highest field `a`: if the seeds
`C` satisfy `a₀C ⊂ W₄` and `S₃ = E_L S₃ + E_R S₃ + span C + N₃`, then `a₀S₃ ⊂ W₄`. -/
theorem raising_saturation {a : V} (ha : a ∈ D.S₂) (heL : A.mode 0 D.eL a = 0)
    (heR : A.mode 0 D.eR a = 0) (C : Set V) (hC : C ⊆ D.S₃)
    (hCW : ∀ p ∈ C, A.mode 0 a p ∈ D.W₄)
    (hspan : D.S₃ ≤ D.S₃.map (A.mode 0 D.eL) ⊔ D.S₃.map (A.mode 0 D.eR) ⊔
      Submodule.span k C ⊔ D.N₃)
    (hnil : ∀ w : List Bool, w.length = 25 → ∀ v ∈ D.S₃,
      CFT.raisingWord (A.mode 0 D.eL) (A.mode 0 D.eR) w v = 0) :
    ∀ s ∈ D.S₃, A.mode 0 a s ∈ D.W₄ := by
  have hEs : ∀ x ∈ D.S₃, A.mode 0 D.eL x ∈ D.S₃ := L.KS₃0 D.eL_mem
  have hFs : ∀ x ∈ D.S₃, A.mode 0 D.eR x ∈ D.S₃ := L.KS₃0 D.eR_mem
  let Cs : Submodule k D.S₃ := (D.W₄.comap (A.mode 0 a)).comap D.S₃.subtype
  -- current covariance: the kernel is stable under the raising currents
  have hstab : ∀ e ∈ D.K, A.mode 0 e a = 0 → ∀ x : V, A.mode 0 a x ∈ D.W₄ →
      A.mode 0 a (A.mode 0 e x) ∈ D.W₄ := by
    intro e he hea x hx
    have h := A.zero_mode_comm (D.K_grade he) (D.S₂_grade ha) 0 x
    rw [hea, map_zero, LinearMap.zero_apply, add_zero] at h
    rw [← h]
    exact L.KW₄0 he _ hx
  have hE : ∀ x ∈ Cs, (A.mode 0 D.eL).restrict hEs x ∈ Cs := fun x hx =>
    hstab D.eL D.eL_mem heL x hx
  have hF : ∀ x ∈ Cs, (A.mode 0 D.eR).restrict hFs x ∈ Cs := fun x hx =>
    hstab D.eR D.eR_mem heR x hx
  have hspan' : ∀ v : D.S₃, ∃ x y c : D.S₃, c ∈ Cs ∧
      v = (A.mode 0 D.eL).restrict hEs x + (A.mode 0 D.eR).restrict hFs y + c := by
    intro v
    obtain ⟨y123, hy123, u₄, hu₄, hsum⟩ := Submodule.mem_sup.mp (hspan v.2)
    obtain ⟨y12, hy12, u₃, hu₃, rfl⟩ := Submodule.mem_sup.mp hy123
    obtain ⟨u₁, hu₁, u₂, hu₂, rfl⟩ := Submodule.mem_sup.mp hy12
    obtain ⟨x, hx, rfl⟩ := Submodule.mem_map.mp hu₁
    obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.mp hu₂
    have hu₃S : u₃ ∈ D.S₃ := (Submodule.span_le.mpr hC) hu₃
    have hu₄S : u₄ ∈ D.S₃ := L.N₃_le_S₃ hu₄
    have hu₃W : A.mode 0 a u₃ ∈ D.W₄ :=
      (Submodule.span_le.mpr hCW : Submodule.span k C ≤ D.W₄.comap (A.mode 0 a)) hu₃
    have hu₄W : A.mode 0 a u₄ ∈ D.W₄ := D.N₄_le_W₄ (L.S₂N₃0 ha u₄ hu₄)
    refine ⟨⟨x, hx⟩, ⟨y, hy⟩, ⟨u₃ + u₄, D.S₃.add_mem hu₃S hu₄S⟩, ?_, ?_⟩
    · show A.mode 0 a (u₃ + u₄) ∈ D.W₄
      rw [map_add]
      exact D.W₄.add_mem hu₃W hu₄W
    · apply Subtype.ext
      show (v : V) = A.mode 0 D.eL x + A.mode 0 D.eR y + (u₃ + u₄)
      rw [← hsum]
      abel
  have hnil' : ∀ w : List Bool, w.length = 25 → ∀ v : D.S₃,
      CFT.raisingWord ((A.mode 0 D.eL).restrict hEs) ((A.mode 0 D.eR).restrict hFs) w v = 0 := by
    intro w hw v
    apply Subtype.ext
    rw [raisingWord_restrict, Submodule.coe_zero]
    exact hnil w hw v v.2
  intro s hs
  exact CFT.nilpotent_raising_saturation Cs ((A.mode 0 D.eL).restrict hEs)
    ((A.mode 0 D.eR).restrict hFs) hE hF hspan' 25 hnil' ⟨s, hs⟩

/-- The singular products `x_(m) s`, `x ∈ K`, `s ∈ S₃`, lie in the ladder. -/
theorem K_S₃_sing {x s : V} (hx : x ∈ D.K) (hs : s ∈ D.S₃) :
    ∀ m : ℕ, m < 1 + 3 → A.mode (m : ℤ) x s ∈ D.ladder (3 - m) := by
  intro m hm
  interval_cases m
  · exact L.KS₃0 hx s hs
  · exact L.KS₃1 hx s hs
  · exact L.KS₃2 hx hs
  · exact A.mode_mem_grade (D.K_grade hx) (D.S₃_grade hs) (by norm_num)

/-- `(x₋₁y)₀v` for currents `x, y` (iterate formula, eq. `eq:iterate`): it lies one step
above `v` in the ladder when the singular products of `x, y` with `v` do. -/
theorem KK_zero_mem {x y v : V} (hx : x ∈ D.K) (hy : y ∈ D.K) {e : ℕ} (hv : v ∈ A.grade e)
    (hsx : ∀ m : ℕ, m < 1 + e → A.mode (m : ℤ) x v ∈ D.ladder (e - m))
    (hsy : ∀ m : ℕ, m < 1 + e → A.mode (m : ℤ) y v ∈ D.ladder (e - m)) :
    A.mode 0 (A.mode (-1) x y) v ∈ D.ladder (e + 1) := by
  refine A.iterate_mem (D.K_grade hx) (D.K_grade hy) hv (-1) 0 (fun t _ => ?_) (fun t _ => ?_)
  · by_cases ht : t < 1 + e
    · have := L.neg_mode_K hx t (e - t) _ (hsy t ht)
      rw [show e - t + t + 1 = e + 1 by omega] at this
      rw [zero_add, show (-1 : ℤ) - t = -(t : ℤ) - 1 by ring]
      exact this
    · rw [zero_add, A.mode_trunc (t : ℤ) (D.K_grade hy) hv (by push_cast; omega), map_zero]
      exact Submodule.zero_mem _
  · by_cases ht : t < 1 + e
    · have := L.neg_mode_K hy t (e - t) _ (hsx t ht)
      rw [show e - t + t + 1 = e + 1 by omega] at this
      rw [show (-1 : ℤ) + 0 - t = -(t : ℤ) - 1 by ring]
      exact this
    · rw [A.mode_trunc (t : ℤ) (D.K_grade hx) hv (by push_cast; omega), map_zero]
      exact Submodule.zero_mem _

/-- **Gate 4** (eq. `eq:gate4`): `(S₂)₀S₃ ⊂ W₄`. -/
theorem gate4 (G : Gate4Certificate D)
    (hnil : ∀ w : List Bool, w.length = 25 → ∀ v ∈ D.S₃,
      CFT.raisingWord (A.mode 0 D.eL) (A.mode 0 D.eR) w v = 0) :
    ∀ a ∈ D.S₂, ∀ s ∈ D.S₃, A.mode 0 a s ∈ D.W₄ := by
  -- the nine joint-highest fields: Lemmas `lem:raising` and `lem:singlet`
  have hhigh : ∀ a ∈ G.highest, ∀ s ∈ D.S₃, A.mode 0 a s ∈ D.W₄ := by
    intro a ha
    refine L.raising_saturation (G.highest_S₂ ha) (G.highest_eL a ha) (G.highest_eR a ha)
      (G.seed a ∪ G.singletSeed a)
      (Set.union_subset (G.seed_S₃ a ha) (G.singletSeed_S₃ a ha)) ?_ (G.raising_span a ha) hnil
    rintro p (hp | hp)
    · exact L.W₄_of_full (G.seed_identity a ha p hp)
    · obtain ⟨n, hn, hPi⟩ := G.projected_residual a ha p hp
      exact L.singlet_recovery (L.W₄_of_full (G.singlet_premise_L a ha p hp))
        (L.W₄_of_full (G.singlet_premise_R a ha p hp)) ⟨n, L.fullN₄_le hn, hPi⟩
  let M : Submodule k V := A.modeSpace 0 D.S₃ D.W₄
  -- current covariance: charged descendants
  have hcur : D.currentSpan G.highest ≤ M ⊓ D.S₂ := by
    refine D.currentSpan_le (fun a ha => ⟨(A.mem_modeSpace).mpr (hhigh a ha),
      G.highest_S₂ ha⟩) ?_
    rintro x hx v ⟨hvM, hvS⟩
    refine ⟨(A.mem_modeSpace).mpr fun s hs => ?_, L.KS₂0 x hx v hvS⟩
    have hvM' := (A.mem_modeSpace).mp hvM
    have h := A.zero_mode_comm (D.K_grade hx) (D.S₂_grade hvS) 0 s
    have h' : A.mode 0 (A.mode 0 x v) s =
        A.mode 0 x (A.mode 0 v s) - A.mode 0 v (A.mode 0 x s) := by
      rw [h]; abel
    rw [h']
    exact D.W₄.sub_mem (L.KW₄0 hx _ (hvM' s hs)) (hvM' _ (L.KS₃0 hx s hs))
  -- the affine vacuum vectors
  have hTK : D.K.map A.T ≤ M := VertexAlgebra.map_T_le fun x _ =>
    (A.mem_modeSpace).mpr fun s _ => by
      rw [A.mode_T_zero]
      exact D.W₄.zero_mem
  have hKK : A.negProd D.K D.K ≤ M := VertexAlgebra.negProd_le fun x hx y hy =>
    (A.mem_modeSpace).mpr fun s hs =>
      L.KK_zero_mem hx hy (D.S₃_grade hs) (L.K_S₃_sing hx hs) (L.K_S₃_sing hy hs)
  -- the conformal vector: `ω₀ = T`
  have hω : (k ∙ A.ω) ≤ M := by
    rw [Submodule.span_singleton_le_iff_mem]
    refine (A.mem_modeSpace).mpr fun s hs => ?_
    rw [A.Lm1]
    exact D.N₄_le_W₄ (D.N₄_of_T hs)
  intro a ha s hs
  have haM : a ∈ M :=
    (sup_le (sup_le (sup_le (hcur.trans inf_le_left) hTK) hKK) hω) (G.S₂_decomp ha)
  exact (A.mem_modeSpace).mp haM s hs

end LowerCertificate

