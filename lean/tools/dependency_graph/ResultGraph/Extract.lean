import ResultGraph.Basic

/-!
# Extraction: reading the graph out of an elaborated environment

Zero annotation is free here, and this is why: the dependencies of a result are
not guessed from cross-references in a document, they are read off the
elaborated proof term. A constant occurring in a declaration's type is a
statement dependency; one occurring only in its value is a proof dependency.

A declaration the rules leave out, whether private, generated by the elaborator
or named in an exclusion, is *transparent* rather than absent: the paths that ran
through it are routed (`Graph.contract`), so leaving it out changes the figure and
not the dependencies the figure reports.

The environment is imported read-only, without loading environment extension
states, so nothing here needs the interpreter or a `lake` invocation.
-/

open Lean

namespace ResultGraph
namespace Extract

/-- What to keep and what to drop when scanning the environment. -/
structure Config where
  /-- Module prefixes whose declarations become nodes. -/
  roots : Array Name := #[]
  /-- Further module prefixes to keep, beyond the roots. -/
  includePrefixes : Array Name := #[]
  /-- Keep every declaration in the environment, dependencies included. Turns a
  Mathlib-based project into a graph of hundreds of thousands of nodes. -/
  keepAll : Bool := false
  /-- Draw `private` declarations, which are dropped by default. -/
  includePrivate : Bool := false
  /-- Draw compiler-generated companions: recursors, `casesOn`, `injEq` and the
  rest. They are dropped by default; they are not results. -/
  includeAuto : Bool := false
  deriving Inhabited

/-- The axioms every Lean development is entitled to use. Depending on these is
not a defect, and flagging it is noise: on a Mathlib-based development almost
every theorem uses `propext`.

`sorryAx` is in the list not because it is harmless but because it is reported
on its own axis: an unfinished proof is a `sorry`, and saying so twice in the
same figure would be worse than saying it once. -/
def standardAxioms : Array Name := #[`propext, `Classical.choice, `Quot.sound, `sorryAx]

/-- Last components of the declarations the elaborator generates alongside a
`def` or an `inductive`. These are machinery, not results. -/
def autoSuffixes : Array String :=
  #["rec", "recOn", "ndrec", "casesOn", "below", "brecOn", "ibelow", "binductionOn",
    "ind", "noConfusion", "noConfusionType", "toCtorIdx", "ofNat", "ofNat_toCtorIdx",
    "eq_def", "sizeOf_spec", "sizeOf_eq", "injEq", "inj", "ctorIdx", "ctorIdx_eq",
    "ctorElim", "ctorElimType", "ofNat_ctorIdx", "congr_simp"]

/-- Suffixes generated once per *constructor* rather than once per declaration.
These are only companions when the parent really is a constructor: `Foo.bar.elim`
is generated, whereas a user's `Empty.elim` is not. -/
def ctorAutoSuffixes : Array String := #["elim"]

/-- The module a constant was declared in. -/
def moduleOf (env : Environment) (n : Name) : Name :=
  match env.getModuleIdxFor? n with
  | some idx => (env.header.moduleNames[idx.toNat]?).getD `_unknown
  | none => `_unknown

/-- Whether `p` names `n` or one of its ancestors, comparing whole components:
`Foo` is a prefix of `Foo.Bar` but not of `FooBar`. -/
def isPrefix (p n : Name) : Bool :=
  p == n || p.isPrefixOf n

/-- Whether a module is one the graph covers. -/
def inScope (cfg : Config) (m : Name) : Bool :=
  cfg.keepAll || (cfg.roots ++ cfg.includePrefixes).any (isPrefix · m)

/-- Whether a constant is one the elaborator generated alongside a user
declaration.

The elaborator's own record of this lives in tagged environment extensions
(`isAuxRecursor` and friends), which are only readable once extension states
have been loaded — and loading them means running the imported project's
initializers through the interpreter. This tool does not, so the test is by
name, narrowed two ways so that it cannot swallow a declaration somebody wrote:

* a *constructor* is never a generated companion. Lean generates theorems,
  definitions and `below`-style inductives, never constructors, so a
  constructor named `inj` is one the author wrote in their `inductive`;
* a companion belongs to something, so `Foo.injEq` only counts as generated
  when `Foo` is itself a declaration. A namespace that merely happens to end in
  such a word keeps its contents. -/
def isAutoGenerated (env : Environment) (n : Name) (ci : ConstantInfo) : Bool :=
  match ci, n with
  -- `structure Foo where …` generates the constructor `Foo.mk`, which carries
  -- no information the structure itself does not. A constructor the author
  -- named in an `inductive`, even one they called `mk`, is theirs — hence the
  -- restriction to single-constructor types.
  | .ctorInfo c, .str _ s =>
    s == "mk" &&
      match env.find? c.induct with
      | some (.inductInfo ind) => ind.ctors.length == 1
      | _ => false
  | .ctorInfo _, _ => false
  | _, .str p s =>
    match env.find? p with
    | none => false
    | some parent =>
      autoSuffixes.contains s
        || (ctorAutoSuffixes.contains s && parent matches .ctorInfo _)
  | _, _ => true

/-- The binder names of `take` arguments of a `∀`-telescope, after skipping
`skip` of them. -/
private def binderNamesAfter (type : Expr) (skip take : Nat) : Array Name := Id.run do
  let mut e := type
  let mut out := #[]
  for _ in *...skip do
    match e with
    | .forallE _ _ body _ => e := body
    | _ => return out
  for _ in *...take do
    match e with
    | .forallE n _ body _ => out := out.push n; e := body
    | _ => return out
  return out

/-- The field names of a structure, read off its constructor's telescope.

The elaborator's own record of what is a structure field lives in an
environment extension, which is only readable once extension states have been
loaded. The constructor's type carries the same information and is always
available. -/
def structureFieldNames (env : Environment) (s : Name) : Array Name :=
  match env.find? s with
  | some (.inductInfo ind) =>
    match ind.ctors with
    | [ctor] =>
      match env.find? ctor with
      | some (.ctorInfo c) => binderNamesAfter c.type c.numParams c.numFields
      | _ => #[]
    | _ => #[]  -- more than one constructor: an inductive, not a structure
  | _ => #[]

/-- Whether a constant is the projection to a parent that `extends` generated.

`class C extends P` gives `C` a field `toP` and makes the projection out of it
an instance, so every statement that uses `C` where a `P` is expected mentions
`C.toP`. That is a real dependency, but it is typeclass plumbing rather than
mathematics, and the parent projections of a widely used class are typically the
busiest nodes in a whole library.

The test is structural, not lexical, because a lexical one would be wrong: a
project's own `Circuit.toBoolFunc` or `Interval.toSet` look identical by name
and must survive. What separates them is that `toSub` really is a *field* of
`SemiringWithMonus`, whereas `toSet` is merely a function about `Interval`. -/
def isParentProjection (env : Environment) : Name → Bool
  | .str s f =>
    match f.toList with
    | 't' :: 'o' :: c :: _ =>
      c.isUpper && (structureFieldNames env s).contains (Name.mkSimple f)
    | _ => false
  | _ => false

/-- Whether a constant is one the project declares, drawn or not.

This is the boundary that really cuts. What the proofs of a *dependency* use is
not this project's dependency graph, so an edge leaving the scope is dropped and
not routed: for a Mathlib-based development, that is the difference between a
figure and the whole of Mathlib. -/
def inProject (env : Environment) (cfg : Config) (n : Name) : Bool :=
  inScope cfg (moduleOf env n)

/-- Whether a constant of the project becomes a node.

A constant this rejects is not thereby absent: `Graph.contract` routes the paths
that ran through it, so a result proved through a private helper still shows what
that helper used. -/
def drawn (env : Environment) (cfg : Config) (n : Name) (ci : ConstantInfo) : Bool :=
  -- Local exhaustive mode: retain internal helpers as well as named companions.
  if cfg.includePrivate && cfg.includeAuto then true else
  let isPriv := isPrivateName n
  -- A private name is mangled to `_private.Mod.0.Foo.bar`, which every internal-detail
  -- test rejects; unmangle before deciding, so that the tests below see what the
  -- user wrote.
  let user := if isPriv then privateToUserName n else n
  if isPriv && !cfg.includePrivate then false
  else if user.isInternalDetail then false
  else if !cfg.includeAuto
      && (isAutoGenerated env user ci || isParentProjection env user
          || Kind.ofConstantInfo ci matches .recr | .quot) then false
  else true

/-- Whether a constant is an axiom, standard or not. -/
def isAxiom (env : Environment) (n : Name) : Bool :=
  match env.find? n with
  | some (.axiomInfo _) => true
  | _ => false

/-- Fold over every constant of the environment, imported or locally added. -/
def foldConstants (env : Environment) (init : σ) (f : σ → Name → ConstantInfo → σ) : σ :=
  Id.run do
    let mut acc := init
    for (n, ci) in env.constants.map₁ do
      acc := f acc n ci
    return env.constants.map₂.foldl (init := acc) f

/-- The constants a declaration's type mentions, and those its value mentions
and its type does not. The split is what separates a dependency of the statement
from a dependency of the proof. -/
def usedConstants (ci : ConstantInfo) : Array Name × Array Name :=
  let inType := ci.type.getUsedConstants
  let inValue := match ci.value? (allowOpaque := true) with
    | some v => v.getUsedConstants
    | none => #[]
  let typeSet := inType.foldl (init := Std.HashSet.emptyWithCapacity inType.size) (·.insert ·)
  (inType, inValue.filter (!typeSet.contains ·))

/-- Whether a declaration's own statement or proof contains `sorry`. -/
def hasSorry (ci : ConstantInfo) : Bool :=
  ci.type.hasSorry || match ci.value? (allowOpaque := true) with
    | some v => v.hasSorry
    | none => false

/-- Propagate a taint forward along the edges: whatever depends on a tainted
declaration is tainted too.

The propagation runs over the project's own declarations only, so it answers
"does this rest on an unfinished proof *of mine*". A `sorry` inside a dependency
outside the extracted scope is invisible to it; for a Mathlib-based development
that is the right boundary, since Mathlib itself is `sorry`-free. -/
def propagate (edges : Array Edge) (seeds : Array Name) : Std.HashSet Name := Id.run do
  let mut succ : Std.HashMap Name (Array Name) := Std.HashMap.emptyWithCapacity edges.size
  for e in edges do
    succ := succ.insert e.src ((succ.getD e.src #[]).push e.tgt)
  let mut tainted : Std.HashSet Name := Std.HashSet.emptyWithCapacity seeds.size
  let mut work := seeds
  for s in seeds do
    tainted := tainted.insert s
  while !work.isEmpty do
    let n := work.back!
    work := work.pop
    for m in succ.getD n #[] do
      if !tainted.contains m then
        tainted := tainted.insert m
        work := work.push m
  return tainted

/-- Extract the whole graph of a project from an imported environment.

Ranks are left at their default here; `ResultGraph.Rank.assign` fills them in. -/
def build (env : Environment) (cfg : Config) : Graph := Id.run do
  -- Every declaration the project makes, drawn or not: the rules that leave one
  -- out make it *transparent*, not absent, so that a chain running through a
  -- private helper or a generated companion is routed and not lost. Edges
  -- leaving the project are dropped, so the graph stays its own, not Mathlib's.
  let kept : Array (Name × ConstantInfo) :=
    foldConstants env #[] fun acc n ci => if inProject env cfg n then acc.push (n, ci) else acc
  let names : Std.HashSet Name :=
    kept.foldl (init := Std.HashSet.emptyWithCapacity kept.size) fun s (n, _) => s.insert n
  let isDrawn : Std.HashSet Name :=
    kept.foldl (init := Std.HashSet.emptyWithCapacity kept.size) fun s (n, ci) =>
      if drawn env cfg n ci then s.insert n else s

  let mut nodes : Array Node := Array.mkEmpty kept.size
  let mut edges : Array Edge := Array.mkEmpty (kept.size * 8)
  let mut sorrySeeds : Array Name := #[]
  let mut axiomSeeds : Array Name := #[]
  for (n, ci) in kept do
    let (inType, inValueOnly) := usedConstants ci
    -- A declaration mentioning itself (a recursive definition, or a theorem
    -- whose statement names it) is not a dependency worth drawing.
    for dep in inType do
      if names.contains dep then
        edges := edges.push { src := dep, tgt := n, kind := .statement }
    for dep in inValueOnly do
      if names.contains dep then
        edges := edges.push { src := dep, tgt := n, kind := .proof }
    let axioms := (inType ++ inValueOnly).filter fun a =>
      -- Exported Mathlib theorems can appear as axiomInfo in Lean's module system.
      -- The full kernel axiom audit is recorded separately by the driver.
      inProject env cfg a && isAxiom env a && !standardAxioms.contains a
    let sorried := hasSorry ci
    if sorried then sorrySeeds := sorrySeeds.push n
    if !axioms.isEmpty then axiomSeeds := axiomSeeds.push n
    nodes := nodes.push
      { name := n
        module := moduleOf env n
        kind := Kind.ofConstantInfo ci
        isPrivate := isPrivateName n
        isUnsafe := ci.isUnsafe
        hasSorry := sorried
        customAxioms := axioms }

  -- Taint travels before the graph is contracted, so it travels through the
  -- declarations that are not drawn: a `sorry` in a private helper is one of
  -- mine, and what rests on it rests on an unfinished proof whether or not the
  -- helper is a node.
  let sorryTainted := propagate edges sorrySeeds
  let axiomTainted := propagate edges axiomSeeds
  nodes := nodes.map fun n =>
    { n with
      sorryTainted := sorryTainted.contains n.name
      axiomTainted := axiomTainted.contains n.name }

  -- The constant map has no meaningful order, so sort: the same project must
  -- produce the same file twice running. `contract` sorts the edges it emits,
  -- and drops the nodes that are not drawn.
  let g : Graph :=
    { roots := cfg.roots, nodes := nodes.qsort (fun a b => Name.lt a.name b.name), edges }
  -- Preserve direct edges (including recursive self references) in exhaustive mode.
  if cfg.includePrivate && cfg.includeAuto then
    return { g with edges := g.edges.qsort fun a b =>
      if a.src == b.src then Name.lt a.tgt b.tgt else Name.lt a.src b.src }
  return g.contract (isDrawn.contains ·)

/-- Import a project's modules.

`initSearchPath` makes the tool honour `LEAN_PATH`, so it can be pointed at any
built project without being part of that project's manifest. What no search
path can fix is a toolchain mismatch: an `.olean` header records the version of
the Lean that wrote it, and any other version refuses to read it. The refusal
comes out as a bare `incompatible header`, which names neither the file's Lean
nor this tool's, so say what it means and what to do about it. -/
def importProject (mods : Array Name) : IO Environment := do
  initSearchPath (← findSysroot)
  try
    importModules (mods.map ({ module := · })) {} 0
  catch e =>
    let msg := toString e
    if (msg.splitOn "incompatible header").length ≤ 1 then throw e
    throw <| IO.userError s!"{msg}\n\
      this project was built by a different Lean than the one that built \
      result-graph, and an .olean can only be read by the version that wrote \
      it: copy the project's lean-toolchain over result-graph's and rebuild."

/-- Import a project's modules and extract its graph. -/
def ofModules (mods : Array Name) (cfg : Config) : IO Graph := do
  let env ← importProject mods
  return build env cfg

end Extract
end ResultGraph
