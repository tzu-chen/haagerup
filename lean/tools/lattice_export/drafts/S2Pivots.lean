theorem s2piv_low : ∀ k < 120, ∀ j < k,
    Vec4.coeff (s2basis.getD k Vec4.zero) (s2piv.getD j vacState) = QA.zero := by
  intro k hk
  by_cases h0 : k < 20
  · exact s2piv_low_0 k hk (by omega) h0
  by_cases h20 : k < 40
  · exact s2piv_low_20 k hk (by omega) h20
  by_cases h40 : k < 60
  · exact s2piv_low_40 k hk (by omega) h40
  by_cases h60 : k < 80
  · exact s2piv_low_60 k hk (by omega) h60
  by_cases h80 : k < 100
  · exact s2piv_low_80 k hk (by omega) h80
  by_cases h100 : k < 120
  · exact s2piv_low_100 k hk (by omega) h100
  omega


