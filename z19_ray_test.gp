\\ Exact ray-class/Stark checks for p=19.
\\ Run with: gp -q z19_ray_test.gp
\\ Requires PARI/GP with bnrstarkunit (tested with 2.17.4).

check(label, condition) =
{
  if(!condition, error(Str("check failed: ", label)));
  print("[ok] ", label);
};

default(parisizemax, 4000000000);
default(realprecision, 100);

T = y^2 - 19*y - 1;
bnf = bnfinit(T, 1);
delta = Mod(y, T);
pp = idealhnf(bnf, delta - 1);

check("base-field class/unit data certify unconditionally", bnfcertify(bnf) == 1);
check("K has class group C2", bnf.no == 2 && bnf.cyc == [2]);
check("PARI class generator is the norm-7 ideal recorded here", idealhnf(bnf,bnf.gen[1]) == [7,1;0,1]);
check("19-delta=-delta^(-1) is the fundamental unit", bnf.fu[1] == 19-delta && delta*(19-delta) == -1);
check("Norm((delta-1)) = 19", idealnorm(bnf, pp) == 19);
real_roots = polrootsreal(T);
print("real roots of delta polynomial = ", real_roots);
check("PARI's second real place is the physical delta > 0 place", real_roots[1] < 0 && real_roots[2] > 0);

bnr_finite = bnrinit(bnf, pp, 1);
bnr_minus = bnrinit(bnf, [pp, [1,0]], 1);
bnr_plus = bnrinit(bnf, [pp, [0,1]], 1);
bnr_both = bnrinit(bnf, [pp, [1,1]], 1);
print("finite ray group = ", bnr_finite.clgp);
print("ray group at infinity_- = ", bnr_minus.clgp);
print("ray group at infinity_+ = ", bnr_plus.clgp);
print("ray group at both infinities = ", bnr_both.clgp);
check("finite ray group is C18", bnr_finite.no == 18 && bnr_finite.cyc == [18]);
check("opposite single-infinity ray group is C18", bnr_minus.no == 18 && bnr_minus.cyc == [18]);
check("physical ray group has order 36 and structure C18 x C2", bnr_plus.no == 36 && bnr_plus.cyc == [18,2]);
check("both-infinity ray group also has structure C18 x C2", bnr_both.no == 36 && bnr_both.cyc == [18,2]);
check("the full physical ray field has conductor pp infinity_+", bnrconductor(bnr_plus) == [pp,[0,1]]);

\\ The ray conductor-discriminant formula gives [absolute degree,r1,disc].
disc_full = bnrdisc(bnr_plus);
check("full ray signature data are [72,36]", disc_full[1] == 72 && disc_full[2] == 36);
check("full absolute discriminant is 365^36*19^34", disc_full[3] == 365^36*19^34);

\\ --------------------------------------------------------------------
\\ Exact subgroup structure
\\ --------------------------------------------------------------------

D = matdiagonal(bnr_plus.cyc);
q2 = idealhnf(bnf,2);
q2_dec = idealprimedec(bnf,2);
q2_class = bnrisprincipal(bnr_plus,q2,0);
check("2 is inert in K and (2) has norm 4", #q2_dec == 1 && idealhnf(bnf,q2_dec[1]) == q2 && idealnorm(bnf,q2) == 4);
check("the ray coordinate of (2) is [10,1]", q2_class == [10,1]~);
check("(2) has ray order 18=ord_19(2)", lcm(18/gcd(q2_class[1],18),2/gcd(q2_class[2],2)) == 18);

\\ The cyclic C18 generated by (2) is the kernel of Cl_m -> Cl(K).
\\ Its ninth power is the infinite inertia element c=[0,1].
H_inertia = mathnf(matconcat([D,q2_class]));
c_infty = [0,1]~;
check("the residue/inertia subgroup has index two", H_inertia == [2,0;0,1] && matdet(H_inertia) == 2);
check("q2^9 is complex conjugation", [(9*q2_class[1])%18,(9*q2_class[2])%2]~ == c_infty);

\\ Quotienting by the residue/inertia C18 gives the Hilbert class field.
unit_ideal = idealhnf(bnf,1);
check("the inertia quotient is everywhere unramified", bnrconductor(bnr_plus,H_inertia) == [unit_ideal,[0,0]]);
hilbert_rel = bnrclassfield(bnr_plus,H_inertia,1);
hilbert_abs = rnfequation(bnf,hilbert_rel);
check("Hilbert class polynomial over K is x^2+3delta-58", hilbert_rel == x^2+3*y-58);
check("Hilbert class polynomial over Q is x^4-59x^2+49", hilbert_abs == x^4-59*x^2+49);
check("Hilbert field discriminant is 365^2", nfdisc(hilbert_abs) == 365^2);
check("Hilbert ray discriminant data agree", bnrdisc(bnr_plus,H_inertia) == [4,4,365^2]);

\\ There are three order-two subgroups of C18 x C2.  Their fixed
\\ fields are the three degree-18 quotients.  H_real=<c> gives the
\\ maximal totally real (finite-ray) field; the other two retain
\\ infinity_+ and are its two complex quadratic twists inside the ray field.
H_twist_a = mathnf(matconcat([D,[9;0]]));
H_real = mathnf(matconcat([D,c_infty]));
H_twist_b = mathnf(matconcat([D,[9;1]]));
check("the three order-two subgroup HNFs are recorded exactly", H_twist_a == [9,0;0,2] && H_real == [18,0;0,1] && H_twist_b == [18,9;0,1]);
check("all three fixed fields are cyclic degree 18 over K", matsnf(H_twist_a) == [18,1] && matsnf(H_real) == [18,1] && matsnf(H_twist_b) == [18,1]);
check("the real quotient drops infinity_+", bnrconductor(bnr_plus,H_real) == [pp,[0,0]]);
check("the two twisted quotients retain infinity_+", bnrconductor(bnr_plus,H_twist_a) == [pp,[0,1]] && bnrconductor(bnr_plus,H_twist_b) == [pp,[0,1]]);

disc_real = bnrdisc(bnr_plus,H_real);
disc_twist_a = bnrdisc(bnr_plus,H_twist_a);
disc_twist_b = bnrdisc(bnr_plus,H_twist_b);
check("real degree-18 quotient has relative discriminant pp^16", disc_real == [36,36,365^18*19^16]);
check("twisted degree-18 quotients have relative discriminant pp^17", disc_twist_a == [36,18,-365^18*19^17] && disc_twist_b == disc_twist_a);
check("the real quotient agrees with the finite ray field", bnrdisc(bnr_finite) == disc_real);

\\ --------------------------------------------------------------------
\\ PARI's conjectural Stark unit for the full physical ray field
\\ --------------------------------------------------------------------

S = bnrstarkunit(bnr_plus);
check("Stark polynomial has degree 36", poldegree(S) == 36);
check("Stark polynomial is reciprocal", x^36*subst(S,x,1/x) == S);
check("Stark polynomial is monic with constant term one", pollead(S) == 1 && polcoef(S,0) == 1);
check("Stark polynomial has integral K-coefficients", denominator(lift(S)) == 1);
check("Stark x^35 coefficient fingerprint", polcoef(S,35) == 30196*delta-575323);
check("Stark middle coefficient fingerprint", polcoef(S,18) == -130503384623693725414853988025319081330527*delta+2486413985136445376140471600973335052109557);
S_factorization = nffactor(bnf,S);
check("Stark polynomial is irreducible over K", matsize(S_factorization)[1] == 1 && poldegree(S_factorization[1,1]) == 36);
check("Stark relative discriminant is pp^34", rnfdisc(bnf,S)[1] == idealpow(bnf,pp,34));
S_conductor = rnfconductor(bnf,S);
check("Stark field conductor is exactly pp infinity_+", S_conductor[1] == [pp,[0,1]]);
check("Stark root generates the full C18 x C2 ray field", S_conductor[2].cyc == [18,2] && S_conductor[3] == D);

\\ For a root s of S, build the unique degree-18 polynomial R such that
\\ S(w)=w^18 R(w+w^(-1)).  It cuts out the fixed field of inversion,
\\ which exact conductor arithmetic identifies as the full finite-ray
\\ (and maximal totally real) subfield.
n = 18;
C = vector(n+1);
C[1] = 2;
C[2] = x;
for(k=2,n,C[k+1] = x*C[k]-C[k-1]);
R = C[n+1] + sum(k=1,n-1,polcoef(S,2*n-k)*C[n-k+1]) + polcoef(S,n);
check("Stark trace polynomial has degree 18", poldegree(R) == 18);
check("S(w)=w^18 R(w+w^(-1)) exactly", w^18*subst(R,x,w+1/w) == subst(S,x,w));
R_factorization = nffactor(bnf,R);
check("Stark trace polynomial is irreducible over K", matsize(R_factorization)[1] == 1 && poldegree(R_factorization[1,1]) == 18);
check("Stark trace field relative discriminant is pp^16", rnfdisc(bnf,R)[1] == idealpow(bnf,pp,16));
R_conductor = rnfconductor(bnf,R);
check("Stark trace field is the full finite C18 ray field", R_conductor[1] == [pp,[0,0]] && R_conductor[2].cyc == [18] && R_conductor[3] == Mat(18));

\\ PARI 2.17.4 rejects direct subgroup calls for the two complex
\\ degree-18 quotients with "incorrect modulus", although their exact
\\ bnrconductor data above satisfy the expected signature condition.
\\ Report this implementation behavior without making it a portable test.
stark_twist_a_status = iferr(poldegree(bnrstarkunit(bnr_plus,H_twist_a)), E, Str(E));
stark_twist_b_status = iferr(poldegree(bnrstarkunit(bnr_plus,H_twist_b)), E, Str(E));
print("bnrstarkunit degree/status for twisted quotient A = ", stark_twist_a_status);
print("bnrstarkunit degree/status for twisted quotient B = ", stark_twist_b_status);

print("base class group = ", bnf.clgp);
print("physical ray group = ", bnr_plus.clgp);
print("full ray discriminant = 365^36 * 19^34 = ", disc_full[3]);
